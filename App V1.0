<!DOCTYPE html>
<html lang="zh-CN" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>德国房产投资全生命周期管理系统 (German Real Estate Asset Management)</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- FontAwesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <!-- Chart.js -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <!-- Google Fonts: Inter & Roboto Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Roboto+Mono:wght@400;500;600;700;900&display=swap" rel="stylesheet">
  
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'system-ui', 'sans-serif'],
            mono: ['Roboto Mono', 'monospace'],
          },
          colors: {
            slate: {
              850: '#151f32',
              900: '#0f172a',
              950: '#090d16',
            }
          }
        }
      }
    }
  </script>
  <style>
    body { font-family: 'Inter', sans-serif; }
    .font-mono { font-family: 'Roboto Mono', monospace; }
    /* 优化表格中等宽字重渲染，保证高对比与清晰加粗 */
    td, th {
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      font-weight: 600;
    }
    /* 自定义滚动条 */
    .scrollbar-thin::-webkit-scrollbar {
      height: 8px;
      width: 8px;
    }
    .scrollbar-thin::-webkit-scrollbar-track {
      background: #090d16;
    }
    .scrollbar-thin::-webkit-scrollbar-thumb {
      background: #1e293b;
      border-radius: 4px;
    }
    .scrollbar-thin::-webkit-scrollbar-thumb:hover {
      background: #334155;
    }
  </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col antialiased selection:bg-sky-500 selection:text-white">

  <!-- 顶部导航栏 -->
  <header class="border-b border-slate-800 bg-slate-900/90 backdrop-blur sticky top-0 z-50 px-4 lg:px-8 py-3.5">
    <div class="max-w-7xl mx-auto flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <div class="flex items-center gap-3">
        <div class="h-10 w-10 rounded-xl bg-gradient-to-tr from-sky-500 to-indigo-600 flex items-center justify-center text-white shadow-lg shadow-sky-500/20">
          <i class="fa-solid fa-building-columns text-lg"></i>
        </div>
        <div>
          <h1 class="text-base font-bold tracking-tight text-white flex items-center gap-2">
            德国房产投资全生命周期管理系统 (German Real Estate Asset Management)
            <span class="text-[10px] font-semibold uppercase tracking-wider bg-sky-500/10 text-sky-400 border border-sky-500/20 px-2 py-0.5 rounded-full">Pro v3.4</span>
          </h1>
          <p class="text-xs text-slate-400">German Real Estate Portfolio & Anlage V Suite</p>
        </div>
      </div>

      <!-- 房产选择与全局动作 -->
      <div class="flex items-center gap-3">
        <div class="flex items-center bg-slate-950 border border-slate-800 rounded-xl px-3 py-1.5 focus-within:border-sky-500 transition">
          <i class="fa-solid fa-house-chimney text-xs text-sky-400 mr-2"></i>
          <select id="propertySelect" class="bg-transparent text-xs text-slate-200 outline-none cursor-pointer pr-4 font-medium" onchange="app.switchProperty(this.value)">
            <!-- 动态生成房产选项 -->
          </select>
        </div>
        <button onclick="app.showAddPropertyModal()" class="px-3 py-1.5 bg-sky-500 hover:bg-sky-400 active:bg-sky-600 text-white rounded-xl text-xs font-semibold flex items-center gap-1.5 shadow-md shadow-sky-500/20 transition">
          <i class="fa-solid fa-plus text-xs"></i>
          <span>新增房产</span>
        </button>
      </div>
    </div>
  </header>

  <!-- 主功能 Tab 导航 -->
  <div class="border-b border-slate-800 bg-slate-900/50 px-4 lg:px-8">
    <div class="max-w-7xl mx-auto flex space-x-1 sm:space-x-2 overflow-x-auto scrollbar-thin py-2">
      <button onclick="app.switchTab('portfolio')" id="tab-portfolio" class="tab-btn px-4 py-2 rounded-xl text-xs font-bold transition flex items-center gap-2 text-sky-400 bg-slate-800/80 border border-slate-700/80">
        <i class="fa-solid fa-chart-pie"></i>
        <span>投资总览大盘 (Portfolio)</span>
      </button>
      <button onclick="app.switchTab('stammdaten')" id="tab-stammdaten" class="tab-btn px-4 py-2 rounded-xl text-xs font-medium transition flex items-center gap-2 text-slate-400 hover:text-slate-200 hover:bg-slate-850">
        <i class="fa-solid fa-sliders"></i>
        <span>单房参数档案 (Stammdaten)</span>
      </button>
      <button onclick="app.switchTab('ledger')" id="tab-ledger" class="tab-btn px-4 py-2 rounded-xl text-xs font-medium transition flex items-center gap-2 text-slate-400 hover:text-slate-200 hover:bg-slate-850">
        <i class="fa-solid fa-book-bookmark"></i>
        <span>按月收支账本 (Monatsbudget)</span>
      </button>
      <button onclick="app.switchTab('weg')" id="tab-weg" class="tab-btn px-4 py-2 rounded-xl text-xs font-medium transition flex items-center gap-2 text-slate-400 hover:text-slate-200 hover:bg-slate-850">
        <i class="fa-solid fa-file-invoice-dollar"></i>
        <span>物业年度决算 (WEG-Abrechnung)</span>
      </button>
      <button onclick="app.switchTab('tax')" id="tab-tax" class="tab-btn px-4 py-2 rounded-xl text-xs font-medium transition flex items-center gap-2 text-slate-400 hover:text-slate-200 hover:bg-slate-850">
        <i class="fa-solid fa-receipt"></i>
        <span>Anlage V 报税清单 (Steuern)</span>
      </button>
    </div>
  </div>

  <!-- 内容承载区 -->
  <main class="flex-1 max-w-7xl w-full mx-auto p-4 lg:p-8 space-y-6">

    <!-- ================= 板块 1: 投资大盘 (Portfolio Overview) ================= -->
    <section id="view-portfolio" class="space-y-6">
      <!-- 核心指标卡 -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="p-4 bg-slate-900 border border-slate-800 rounded-2xl relative overflow-hidden shadow-sm">
          <span class="text-xs text-slate-400 block font-medium">总房产评估资产总额</span>
          <div id="statTotalAssetVal" class="text-2xl font-black text-white mt-1 font-mono">0.00 €</div>
          <div class="mt-2 text-[11px] text-slate-400 flex items-center justify-between">
            <span>净购房总成本</span>
            <span id="statTotalCost" class="font-mono text-slate-200 font-bold">0.00 €</span>
          </div>
          <div class="absolute -right-3 -bottom-3 text-slate-800/40 text-6xl pointer-events-none"><i class="fa-solid fa-city"></i></div>
        </div>

        <div class="p-4 bg-slate-900 border border-slate-800 rounded-2xl relative overflow-hidden shadow-sm">
          <span class="text-xs text-slate-400 block font-medium">当前贷款总负债 (Restschuld)</span>
          <div id="statTotalDebt" class="text-2xl font-black text-rose-400 mt-1 font-mono">0.00 €</div>
          <div class="mt-2 text-[11px] text-slate-400 flex items-center justify-between">
            <span>纯本金净资产 (Eigenkapital)</span>
            <span id="statTotalEquity" class="font-mono text-sky-400 font-bold">0.00 €</span>
          </div>
          <div class="absolute -right-3 -bottom-3 text-slate-800/40 text-6xl pointer-events-none"><i class="fa-solid fa-scale-unbalanced"></i></div>
        </div>

        <div class="p-4 bg-slate-900 border border-slate-800 rounded-2xl relative overflow-hidden shadow-sm">
          <span class="text-xs text-slate-400 block font-medium">合同月租金 (冷租) 总计</span>
          <div id="statMonthlyKalt" class="text-2xl font-black text-emerald-400 mt-1 font-mono">0.00 €</div>
          <div class="mt-2 text-[11px] text-slate-400 flex items-center justify-between">
            <span>年化平均毛租金回报率</span>
            <span id="statGrossYield" class="font-mono text-emerald-400 font-bold">0.0%</span>
          </div>
          <div class="absolute -right-3 -bottom-3 text-slate-800/40 text-6xl pointer-events-none"><i class="fa-solid fa-hand-holding-dollar"></i></div>
        </div>

        <div class="p-4 bg-slate-900 border border-slate-800 rounded-2xl relative overflow-hidden shadow-sm">
          <span class="text-xs text-slate-400 block font-medium">累计落袋净现金流 (Gesamt)</span>
          <div id="statCumulativeCashflow" class="text-2xl font-black text-emerald-400 mt-1 font-mono">+0.00 €</div>
          <div class="mt-2 text-[11px] text-slate-400 flex items-center justify-between">
            <span>已记录月数: <b id="statRecordedMonths" class="text-slate-200">0</b> 个月</span>
            <span class="text-emerald-500 font-semibold">银行实收实付</span>
          </div>
          <div class="absolute -right-3 -bottom-3 text-slate-800/40 text-6xl pointer-events-none"><i class="fa-solid fa-piggy-bank"></i></div>
        </div>
      </div>

      <!-- 图表与资产列表 -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 p-5 bg-slate-900 border border-slate-800 rounded-2xl space-y-4 shadow-sm">
          <div class="flex items-center justify-between">
            <h2 class="text-sm font-bold text-white flex items-center gap-2">
              <i class="fa-solid fa-chart-line text-sky-400"></i>
              <span>资产权益演变与被动积累预测 (Vermögensaufbau)</span>
            </h2>
            <span class="text-xs text-slate-400">基于等额本息递减模型</span>
          </div>
          <div class="h-64 w-full">
            <canvas id="equityChart"></canvas>
          </div>
        </div>

        <div class="p-5 bg-slate-900 border border-slate-800 rounded-2xl space-y-4 shadow-sm flex flex-col justify-between">
          <div>
            <h2 class="text-sm font-bold text-white flex items-center gap-2 mb-3">
              <i class="fa-solid fa-shield-halved text-amber-400"></i>
              <span>关键安全指标监控 (Key Safety Metrics)</span>
            </h2>
            <div class="space-y-3.5 text-xs">
              <div>
                <div class="flex justify-between text-slate-300 mb-1">
                  <span>总体贷款价值比 (LTV):</span>
                  <span id="metricLTV" class="font-mono font-bold text-amber-400">0.0%</span>
                </div>
                <div class="w-full bg-slate-950 rounded-full h-2 overflow-hidden border border-slate-800">
                  <div id="barLTV" class="bg-amber-400 h-full rounded-full transition-all duration-500" style="width: 0%"></div>
                </div>
              </div>

              <div>
                <div class="flex justify-between text-slate-300 mb-1">
                  <span>偿债覆盖率 (DSCR):</span>
                  <span id="metricDSCR" class="font-mono font-bold text-emerald-400">0.00x</span>
                </div>
                <div class="w-full bg-slate-950 rounded-full h-2 overflow-hidden border border-slate-800">
                  <div id="barDSCR" class="bg-emerald-400 h-full rounded-full transition-all duration-500" style="width: 0%"></div>
                </div>
              </div>

              <div class="pt-2 border-t border-slate-800 text-[11px] text-slate-400 space-y-1">
                <p><i class="fa-solid fa-circle-info text-sky-400 mr-1"></i> DSCR > 1.2x 代表租金可完全覆盖本息且有抗风险留存。</p>
                <p><i class="fa-solid fa-circle-info text-sky-400 mr-1"></i> LTV &lt; 70% 代表已脱离银行严格监管负债线。</p>
              </div>
            </div>
          </div>
          <div class="mt-4 p-3 bg-slate-950/70 border border-slate-800 rounded-xl">
            <div class="flex items-center justify-between text-xs">
              <span class="text-slate-400">当前名下房产总套数:</span>
              <span id="statPropertyCount" class="font-bold text-white font-mono">1 套</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= 板块 2: 单房参数档案 (Stammdaten) ================= -->
    <section id="view-stammdaten" class="hidden space-y-6">
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-sm">
        <div class="flex flex-col md:flex-row md:items-center justify-between pb-5 border-b border-slate-800 gap-3">
          <div>
            <h2 class="text-base font-bold text-white flex items-center gap-2">
              <i class="fa-solid fa-file-contract text-sky-400"></i>
              <span id="stammPropTitle">房产基本档案与融资结构</span>
            </h2>
            <p class="text-xs text-slate-400 mt-0.5">录入并核算购房原值、法定折旧基数、贷款契约及物业费拆分</p>
          </div>
          <button onclick="app.saveCurrentPropertyStammdaten()" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-500 active:bg-emerald-700 text-white rounded-xl text-xs font-bold flex items-center gap-1.5 transition shadow-sm">
            <i class="fa-solid fa-floppy-disk"></i>
            <span>保存当前房产配置</span>
          </button>
        </div>

        <form id="stammForm" class="mt-6 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 text-xs">
          <!-- 1. 基础信息与购置成本 -->
          <div class="space-y-4 bg-slate-950/50 p-4 rounded-xl border border-slate-800/80">
            <h3 class="font-bold text-sky-400 uppercase text-[11px] tracking-wider flex items-center gap-2">
              <i class="fa-solid fa-location-dot"></i>
              <span>1. 基础信息与购置原值</span>
            </h3>

            <div>
              <label class="block text-slate-400 text-[11px] mb-1">房产标识名称 (Bezeichnung / Adresse)</label>
              <input id="inputPropName" type="text" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-slate-100 font-medium focus:border-sky-500 focus:outline-none">
            </div>

            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="block text-slate-400 text-[11px] mb-1">公证签约日 (Notar)</label>
                <input id="inputPropNotarDate" type="date" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-slate-100 font-mono focus:border-sky-500 focus:outline-none">
              </div>
              <div>
                <label class="block text-slate-400 text-[11px] mb-1 text-sky-300 font-semibold">钥匙交接日 (Übergabe)</label>
                <input id="inputPropUebergang" type="date" class="w-full bg-slate-900 border border-sky-500/50 rounded-lg px-3 py-2 text-slate-100 font-mono focus:border-sky-500 focus:outline-none" title="即Nutzen-Lasten-Wechsel，收租、交物业费与开始折旧的法定基准日">
              </div>
            </div>

            <div>
              <label class="block text-slate-400 text-[11px] mb-1">净买入价 (Kaufpreis, €)</label>
              <input id="inputPropKaufpreis" type="number" step="1000" oninput="app.calcPurchaseCosts()" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-slate-100 font-mono font-bold focus:border-sky-500 focus:outline-none">
            </div>

            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="block text-slate-400 text-[11px] mb-1">建筑物比例 (%)</label>
                <input id="inputPropGebaeudeAnteil" type="number" step="0.5" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-slate-100 font-mono focus:border-sky-500 focus:outline-none">
              </div>
              <div>
                <label class="block text-slate-400 text-[11px] mb-1">年折旧率 (AfA, %)</label>
                <input id="inputPropAfaRate" type="number" step="0.5" value="2.0" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-slate-100 font-mono focus:border-sky-500 focus:outline-none">
              </div>
            </div>

            <!-- 购房杂费拆解为 4 大类 -->
            <div class="p-3 bg-slate-900 rounded-lg border border-slate-800 space-y-2">
              <div class="flex justify-between items-center text-slate-300 font-bold text-[11px]">
                <span>购房杂费明细 (Kaufnebenkosten)</span>
                <span id="displayTotalKaufNk" class="text-sky-400 font-mono font-bold">0.00 €</span>
              </div>
              <div class="grid grid-cols-2 gap-2 text-[10px]">
                <div>
                  <label class="text-slate-400 block mb-0.5">1. 契税/地税 (€)</label>
                  <input id="inputNkGrunderwerb" type="number" step="50" oninput="app.calcPurchaseCosts()" placeholder="如 NRW 6.5%" class="w-full bg-slate-950 border border-slate-700 rounded px-2 py-1.5 text-white font-mono">
                </div>
                <div>
                  <label class="text-slate-400 block mb-0.5">2. 公证处费 (€)</label>
                  <input id="inputNkNotar" type="number" step="50" oninput="app.calcPurchaseCosts()" placeholder="约 1.5%" class="w-full bg-slate-950 border border-slate-700 rounded px-2 py-1.5 text-white font-mono">
                </div>
                <div>
                  <label class="text-slate-400 block mb-0.5">3. 购房中介费 (€)</label>
                  <input id="inputNkMakler" type="number" step="50" oninput="app.calcPurchaseCosts()" placeholder="如 3.57%" class="w-full bg-slate-950 border border-slate-700 rounded px-2 py-1.5 text-white font-mono">
                </div>
                <div>
                  <label class="text-slate-400 block mb-0.5">4. 土地登记局费 (€)</label>
                  <input id="inputNkGrundbuch" type="number" step="50" oninput="app.calcPurchaseCosts()" placeholder="约 0.5%" class="w-full bg-slate-950 border border-slate-700 rounded px-2 py-1.5 text-white font-mono">
                </div>
              </div>
            </div>
          </div>

          <!-- 2. 融资贷款契约 (完整支持: 商业主贷 + KfW 1 + KfW 2) -->
          <div class="space-y-4 bg-slate-950/50 p-4 rounded-xl border border-slate-800/80">
            <h3 class="font-bold text-sky-400 uppercase text-[11px] tracking-wider flex items-center gap-2">
              <i class="fa-solid fa-landmark"></i>
              <span>2. 银行贷款契约 (Darlehen & KfW)</span>
            </h3>

            <!-- 商业主贷款 1 -->
            <div class="p-3 bg-slate-900 rounded-lg border border-slate-800 space-y-2">
              <div class="flex justify-between items-center">
                <span class="font-bold text-slate-200">商业主贷款 (Bankdarlehen 1)</span>
                <span class="text-[10px] text-sky-400 bg-sky-950/80 px-2 py-0.5 rounded border border-sky-800/50">已激活</span>
              </div>
              <div class="grid grid-cols-3 gap-2">
                <div>
                  <label class="block text-slate-400 text-[10px] mb-0.5">本金 (€)</label>
                  <input id="inputLoan1Amount" type="number" step="1000" class="w-full bg-slate-950 border border-slate-700 rounded px-2 py-1.5 text-white font-mono text-xs">
                </div>
                <div>
                  <label class="block text-slate-400 text-[10px] mb-0.5">年利率 (%)</label>
                  <input id="inputLoan1Rate" type="number" step="0.01" class="w-full bg-slate-950 border border-slate-700 rounded px-2 py-1.5 text-white font-mono text-xs">
                </div>
                <div>
                  <label class="block text-slate-400 text-[10px] mb-0.5">约定还本率 (%)</label>
                  <input id="inputLoan1Tilgung" type="number" step="0.01" title="等额本息合同约定还本比例" class="w-full bg-slate-950 border border-slate-700 rounded px-2 py-1.5 text-white font-mono text-xs">
                </div>
              </div>
            </div>

            <!-- KfW 贷款 1 -->
            <div class="p-3 bg-slate-900 rounded-lg border border-slate-800 space-y-2">
              <div class="flex justify-between items-center">
                <span class="font-bold text-slate-200">KfW 贷款 1 (z.B. KfW 124/261)</span>
                <label class="flex items-center gap-1.5 cursor-pointer">
                  <input id="inputLoan2Active" type="checkbox" onchange="app.toggleLoanActive(2, this.checked)" class="rounded bg-slate-950 border-slate-700 text-sky-500 focus:ring-0">
                  <span class="text-[10px] text-slate-400">启用</span>
                </label>
              </div>
              <div id="loan2Fields" class="grid grid-cols-3 gap-2 opacity-50 pointer-events-none transition">
                <div>
                  <label class="block text-slate-400 text-[10px] mb-0.5">本金 (€)</label>
                  <input id="inputLoan2Amount" type="number" step="1000" class="w-full bg-slate-950 border border-slate-700 rounded px-2 py-1.5 text-white font-mono text-xs">
                </div>
                <div>
                  <label class="block text-slate-400 text-[10px] mb-0.5">年利率 (%)</label>
                  <input id="inputLoan2Rate" type="number" step="0.01" class="w-full bg-slate-950 border border-slate-700 rounded px-2 py-1.5 text-white font-mono text-xs">
                </div>
                <div>
                  <label class="block text-slate-400 text-[10px] mb-0.5">约定还本率 (%)</label>
                  <input id="inputLoan2Tilgung" type="number" step="0.01" class="w-full bg-slate-950 border border-slate-700 rounded px-2 py-1.5 text-white font-mono text-xs">
                </div>
              </div>
            </div>

            <!-- KfW 贷款 2 / 次级贷款 -->
            <div class="p-3 bg-slate-900 rounded-lg border border-slate-800 space-y-2">
              <div class="flex justify-between items-center">
                <span class="font-bold text-slate-200">KfW 贷款 2 / 次级贷款 (Darlehen 3)</span>
                <label class="flex items-center gap-1.5 cursor-pointer">
                  <input id="inputLoan3Active" type="checkbox" onchange="app.toggleLoanActive(3, this.checked)" class="rounded bg-slate-950 border-slate-700 text-sky-500 focus:ring-0">
                  <span class="text-[10px] text-slate-400">启用</span>
                </label>
              </div>
              <div id="loan3Fields" class="grid grid-cols-3 gap-2 opacity-50 pointer-events-none transition">
                <div>
                  <label class="block text-slate-400 text-[10px] mb-0.5">本金 (€)</label>
                  <input id="inputLoan3Amount" type="number" step="1000" class="w-full bg-slate-950 border border-slate-700 rounded px-2 py-1.5 text-white font-mono text-xs">
                </div>
                <div>
                  <label class="block text-slate-400 text-[10px] mb-0.5">年利率 (%)</label>
                  <input id="inputLoan3Rate" type="number" step="0.01" class="w-full bg-slate-950 border border-slate-700 rounded px-2 py-1.5 text-white font-mono text-xs">
                </div>
                <div>
                  <label class="block text-slate-400 text-[10px] mb-0.5">约定还本率 (%)</label>
                  <input id="inputLoan3Tilgung" type="number" step="0.01" class="w-full bg-slate-950 border border-slate-700 rounded px-2 py-1.5 text-white font-mono text-xs">
                </div>
              </div>
            </div>
          </div>

          <!-- 3. 运营租金与物业费基准 -->
          <div class="space-y-4 bg-slate-950/50 p-4 rounded-xl border border-slate-800/80">
            <h3 class="font-bold text-sky-400 uppercase text-[11px] tracking-wider flex items-center gap-2">
              <i class="fa-solid fa-coins"></i>
              <span>3. 当月合同基准 (Monatliche Miete & Hausgeld)</span>
            </h3>

            <div>
              <label class="block text-slate-400 text-[11px] mb-1">当月签约冷租 (Kaltmiete, €)</label>
              <input id="inputPropKaltmiete" type="number" step="10" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-emerald-400 font-mono font-bold focus:border-sky-500 focus:outline-none">
            </div>

            <div>
              <label class="block text-slate-400 text-[11px] mb-1">当月租客预缴杂费 (NK-Vorauszahlung, €)</label>
              <input id="inputPropNk" type="number" step="10" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-slate-100 font-mono focus:border-sky-500 focus:outline-none">
            </div>

            <div class="p-3 bg-slate-900 rounded-lg border border-slate-800 space-y-2">
              <div class="flex justify-between items-center">
                <label class="text-slate-300 font-bold text-xs">当月打款物业费 (Hausgeld, €)</label>
                <input id="inputPropHausgeld" type="number" step="1" class="w-28 bg-slate-950 border border-slate-700 rounded px-2 py-1 text-white font-mono text-right text-xs">
              </div>
              <div class="text-[11px] text-slate-400 space-y-1 pt-1 border-t border-slate-800">
                <div class="flex justify-between">
                  <span>其中预估维修基金 (Rücklage):</span>
                  <span id="displayRuecklageAnteils" class="font-mono text-amber-400">约 0.00 €</span>
                </div>
                <div class="flex justify-between">
                  <span>其中可转嫁租客运营成本:</span>
                  <span id="displayUmlageAnteils" class="font-mono text-slate-300">约 0.00 €</span>
                </div>
              </div>
            </div>
          </div>
        </form>
      </div>
    </section>

    <!-- ================= 板块 3: 按月收支账本 (Monatsbudget & Ledger) ================= -->
    <section id="view-ledger" class="hidden space-y-4">
      
      <!-- 智能欠缺月份补齐横幅 (Catch-up Prompt Banner) -->
      <div id="catchUpBanner" class="hidden bg-gradient-to-r from-amber-950/40 via-amber-900/30 to-slate-900 border border-amber-600/40 rounded-2xl p-4 flex flex-col sm:flex-row items-center justify-between gap-3 shadow-md">
        <div class="flex items-center gap-3">
          <div class="h-9 w-9 rounded-xl bg-amber-500/20 text-amber-400 border border-amber-500/30 flex items-center justify-center text-lg flex-shrink-0">
            <i class="fa-solid fa-wand-magic-sparkles"></i>
          </div>
          <div>
            <h4 class="text-xs font-bold text-amber-200">账单连续性智能提醒 / Fehlende Monate ergänzen</h4>
            <p id="catchUpBannerText" class="text-[11px] text-slate-300 mt-0.5">检测到有尚未排布的月份记录。</p>
          </div>
        </div>
        <div class="flex items-center gap-2">
          <button onclick="app.runCatchUpFromBanner()" class="px-3.5 py-1.5 bg-amber-500 hover:bg-amber-400 active:bg-amber-600 text-slate-950 rounded-xl text-xs font-bold transition flex items-center gap-1.5 shadow">
            <i class="fa-solid fa-bolt text-xs"></i>
            <span>一键顺延补齐至当月</span>
          </button>
          <button onclick="app.dismissCatchUpBanner()" class="p-1.5 text-slate-400 hover:text-slate-200 text-xs">
            <i class="fa-solid fa-xmark"></i>
          </button>
        </div>
      </div>

      <!-- 操作栏与视图切换器 -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-slate-900 border border-slate-800 p-3.5 rounded-2xl">
        <div class="flex items-center gap-3">
          <!-- 方案 B 双视图切换开关 (View Switcher) -->
          <div class="flex bg-slate-950 p-1 rounded-xl border border-slate-800 text-xs">
            <button id="viewToggleMonthlyBtn" onclick="app.switchLedgerSubView('monthly')" class="px-3 py-1.5 rounded-lg font-bold transition flex items-center gap-1.5 bg-slate-800 text-sky-400 shadow-sm">
              <i class="fa-solid fa-table-list"></i>
              <span>按月流水明细</span>
            </button>
            <button id="viewToggleYearlyBtn" onclick="app.switchLedgerSubView('yearly')" class="px-3 py-1.5 rounded-lg font-medium transition flex items-center gap-1.5 text-slate-400 hover:text-slate-200">
              <i class="fa-solid fa-chart-column"></i>
              <span>年度汇总对比</span>
            </button>
          </div>

          <div class="text-xs text-slate-400 hidden md:block">
            <span class="text-slate-500">|</span> 记录真实发生的银行流水与租客收付
          </div>
        </div>

        <div class="flex items-center gap-2">
          <button onclick="app.openBatchGenerateModal()" class="px-3 py-1.5 bg-slate-800 hover:bg-slate-750 text-slate-200 border border-slate-700 rounded-xl text-xs font-semibold flex items-center gap-1.5 transition">
            <i class="fa-solid fa-calendar-plus text-sky-400"></i>
            <span>区间批量生成</span>
          </button>
          <button onclick="app.openLedgerModal()" class="px-3.5 py-1.5 bg-sky-500 hover:bg-sky-400 active:bg-sky-600 text-white rounded-xl text-xs font-bold flex items-center gap-1.5 shadow-md shadow-sky-500/20 transition">
            <i class="fa-solid fa-plus text-xs"></i>
            <span>录入单月记录</span>
          </button>
        </div>
      </div>

      <!-- 子视图 1: 按月流水表格明细 -->
      <div id="ledgerMonthlyContainer" class="bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden shadow-sm">
        <div class="overflow-x-auto max-h-[620px] scrollbar-thin">
          <table class="w-full text-left text-xs border-collapse">
            <thead class="sticky top-0 z-30 bg-slate-950 text-slate-400 font-medium border-b border-slate-800 text-[11px]">
              <tr class="whitespace-nowrap">
                <th class="p-3 sticky left-0 z-40 bg-slate-950 shadow-[2px_0_5px_-2px_rgba(0,0,0,0.5)] min-w-[120px]">月份 (Monat)</th>
                <th class="p-3 text-right min-w-[110px]">冷租 (Kalt)</th>
                <th class="p-3 text-right min-w-[105px]">预缴杂费 (NK)</th>
                <th class="p-3 text-right text-emerald-400 min-w-[110px]">其他收入 (Sonst. Einn.)</th>
                <th class="p-3 text-right text-rose-300 min-w-[110px]">银行利息 (Zins)</th>
                <th class="p-3 text-right text-sky-300 min-w-[110px]">还本 (Tilgung)</th>
                <th class="p-3 text-right text-rose-300 min-w-[110px]">物业费 (Hausgeld)</th>
                <th class="p-3 text-right text-rose-400 min-w-[105px]">维修 (Reparatur)</th>
                <th class="p-3 text-right text-purple-400 min-w-[105px]">中介 (Makler)</th>
                <th class="p-3 text-right text-amber-400 min-w-[105px]">购置 (Anschaffung)</th>
                <th class="p-3 text-right text-slate-300 min-w-[110px]">其他支出 (Sonst. Ausg.)</th>
                <th class="p-3 text-right font-bold text-white min-w-[125px]">净现金流 (Netto-CF)</th>
                <th class="p-3 text-center min-w-[100px]">备注与操作</th>
              </tr>
            </thead>
            <tbody id="ledgerSummaryRow" class="sticky top-[37px] z-20 bg-slate-900/95 font-bold font-mono text-[11px] border-b-2 border-sky-500/40 text-slate-200">
              <!-- 动态填充汇总 -->
            </tbody>
            <tbody id="ledgerTableBody" class="divide-y divide-slate-800/60 font-mono text-[11px] font-semibold">
              <!-- 动态填充流水 -->
            </tbody>
          </table>
        </div>
      </div>

      <!-- 子视图 2: 方案 B 独立年度汇总对比看板 -->
      <div id="ledgerYearlyContainer" class="hidden space-y-6">
        <!-- 跨年度多维度横向对比表格 -->
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-sm space-y-3">
          <div class="flex items-center justify-between">
            <h3 class="text-sm font-bold text-white flex items-center gap-2">
              <i class="fa-solid fa-table-columns text-sky-400"></i>
              <span>多年度横向并列对比表 (Mehrjahresvergleich)</span>
            </h3>
            <span class="text-xs text-slate-400">自动归集各自然年份真实收支明细</span>
          </div>

          <div class="overflow-x-auto scrollbar-thin">
            <table id="yearlyComparisonTable" class="w-full text-left text-xs border-collapse">
              <!-- 动态生成多年度横向表头与每一行科目对比 -->
            </table>
          </div>
        </div>

        <!-- 多年度收支柱状对比图与关键洞察 -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
          <div class="lg:col-span-2 bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-sm space-y-4">
            <div class="flex items-center justify-between">
              <h3 class="text-sm font-bold text-white flex items-center gap-2">
                <i class="fa-solid fa-chart-column text-emerald-400"></i>
                <span>收支科目跨年份结构对比 (Aufwand & Ertrag im Mehrjahresvergleich)</span>
              </h3>
              <span class="text-xs text-slate-400 font-mono">按收支类别对比各年份走势</span>
            </div>
            <div class="h-80 w-full relative">
              <canvas id="yearlyTrendsChart"></canvas>
            </div>
          </div>

          <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-sm space-y-4 flex flex-col justify-between">
            <div>
              <h3 class="text-sm font-bold text-white flex items-center gap-2 mb-3">
                <i class="fa-solid fa-lightbulb text-amber-400"></i>
                <span>年度投资财务洞察 (Insights)</span>
              </h3>
              <div id="yearlyInsightsContent" class="space-y-3 text-xs">
                <!-- 动态生成洞察文字 -->
              </div>
            </div>
            <div class="p-3 bg-slate-950/80 border border-slate-800 rounded-xl text-[11px] text-slate-400">
              <i class="fa-solid fa-circle-check text-emerald-400 mr-1"></i>
              本金还款部分为纯资产沉淀，净现金流为银行账户实打实留存。
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= 板块 4: 物业年度决算单 (WEG) ================= -->
    <section id="view-weg" class="hidden space-y-6">
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-sm">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-5 border-b border-slate-800 gap-3">
          <div>
            <h2 class="text-base font-bold text-white flex items-center gap-2">
              <i class="fa-solid fa-file-invoice text-sky-400"></i>
              <span>物业年度决算录入与租客对账 (WEG & Mieterabrechnung)</span>
            </h2>
            <p class="text-xs text-slate-400 mt-0.5">当收到物业管理处决算单时录入，系统自动剥离真实维修基金并计算租客退补</p>
          </div>
          <button onclick="app.openWegModal()" class="px-3.5 py-2 bg-sky-500 hover:bg-sky-400 text-white rounded-xl text-xs font-bold flex items-center gap-1.5 transition shadow">
            <i class="fa-solid fa-plus text-xs"></i>
            <span>录入新决算单</span>
          </button>
        </div>

        <div class="mt-5 overflow-x-auto scrollbar-thin">
          <table class="w-full text-left text-xs border-collapse">
            <thead class="bg-slate-950 text-slate-400 border-b border-slate-800 text-[11px]">
              <tr class="whitespace-nowrap">
                <th class="p-3">决算经济年度</th>
                <th class="p-3">物业扣款/到账日</th>
                <th class="p-3 text-right">租客可分摊成本 (Umlagefähig)</th>
                <th class="p-3 text-right">不可分摊管理费 (Nicht umlagefähig)</th>
                <th class="p-3 text-right text-amber-200">维修基金全年存入</th>
                <th class="p-3 text-right text-amber-400">维修基金当年实际动用</th>
                <th class="p-3 text-right">房东物业结算差额</th>
                <th class="p-3 text-right">租客应补/(退)差额</th>
                <th class="p-3">租客差额到账月</th>
                <th class="p-3 text-center">操作</th>
              </tr>
            </thead>
            <tbody id="wegTableBody" class="divide-y divide-slate-800/60 font-mono text-[11px]">
              <!-- 动态填充决算记录 -->
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ================= 板块 5: Anlage V 报税清单 (Steuern) ================= -->
    <section id="view-tax" class="hidden space-y-6">
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-sm">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-5 border-b border-slate-800 gap-3">
          <div>
            <h2 class="text-base font-bold text-white flex items-center gap-2">
              <i class="fa-solid fa-receipt text-sky-400"></i>
              <span>德国个人所得税 Anlage V 报税对账单</span>
            </h2>
            <p class="text-xs text-slate-400 mt-0.5">严格遵循 § 11 EStG 收付实现制，自动按税法法定行号归集抵扣项</p>
          </div>
          
          <div class="flex items-center gap-3">
            <div class="flex items-center bg-slate-950 border border-slate-800 rounded-xl px-3 py-1.5">
              <span class="text-xs text-slate-400 mr-2">报税年度:</span>
              <select id="taxYearSelect" class="bg-transparent text-xs text-sky-400 font-bold outline-none cursor-pointer" onchange="app.renderTaxView()">
                <option value="2024">2024 年度</option>
                <option value="2025" selected>2025 年度</option>
                <option value="2026">2026 年度</option>
              </select>
            </div>
            <div class="flex items-center bg-slate-950 border border-slate-800 rounded-xl px-3 py-1.5">
              <span class="text-xs text-slate-400 mr-2">个人边际税率:</span>
              <input id="inputTaxMarginalRate" type="number" value="42" min="0" max="45" step="1" class="w-10 bg-transparent text-xs text-emerald-400 font-mono font-bold outline-none" onchange="app.renderTaxView()">
              <span class="text-xs text-slate-400">%</span>
            </div>
          </div>
        </div>

        <div class="mt-5 grid grid-cols-1 md:grid-cols-2 gap-6 text-xs">
          <div class="space-y-3 bg-slate-950/60 p-4 rounded-xl border border-slate-800">
            <h3 class="font-bold text-sky-400 uppercase text-[11px] tracking-wider pb-2 border-b border-slate-800">1. 出租总收入 (Einnahmen)</h3>
            <div class="space-y-2 font-mono">
              <div class="flex justify-between py-1 border-b border-slate-850">
                <span class="text-slate-400">Zeile 9: 全年冷租收入 (Kaltmiete)</span>
                <span id="taxSumKaltmiete" class="text-white font-bold">0.00 €</span>
              </div>
              <div class="flex justify-between py-1 border-b border-slate-850">
                <span class="text-slate-400">Zeile 13: 租客预缴杂费 (Umlagen)</span>
                <span id="taxSumNebenkosten" class="text-white">0.00 €</span>
              </div>
              <div class="flex justify-between pt-2 text-sm text-sky-300 font-bold">
                <span>总收入合计 (Summe Einnahmen):</span>
                <span id="taxTotalEinnahmen">0.00 €</span>
              </div>
            </div>
          </div>

          <div class="space-y-3 bg-slate-950/60 p-4 rounded-xl border border-slate-800">
            <h3 class="font-bold text-rose-400 uppercase text-[11px] tracking-wider pb-2 border-b border-slate-800">2. 可抵税开支 (Werbungskosten)</h3>
            <div class="space-y-2 font-mono">
              <div class="flex justify-between py-1 border-b border-slate-850">
                <span class="text-slate-400">Zeile 33: 建筑物法定折旧 (AfA)</span>
                <span id="taxAfaVal" class="text-white font-bold">0.00 €</span>
              </div>
              <div class="flex justify-between py-1 border-b border-slate-850">
                <span class="text-slate-400">Zeile 36: 银行贷款利息 (Schuldzinsen)</span>
                <span id="taxSumZinsen" class="text-white font-bold">0.00 €</span>
              </div>
              <div class="flex justify-between py-1 border-b border-slate-850">
                <span class="text-slate-400">Zeile 39: 房屋维修修缮费 (Erhaltungsaufwand)</span>
                <span id="taxSumReparatur" class="text-white">0.00 €</span>
              </div>
              <div class="flex justify-between py-1 border-b border-slate-850">
                <span class="text-slate-400">Zeile 46-48: 物业费中运营与管理费</span>
                <span id="taxSumHausgeld" class="text-white">0.00 €</span>
              </div>
              <div class="flex justify-between py-1 border-b border-slate-850">
                <span class="text-slate-400">其他可抵扣杂费 (中介、购置、杂项)</span>
                <span id="taxSumSonstige" class="text-white">0.00 €</span>
              </div>
              <div class="flex justify-between pt-2 text-sm text-rose-400 font-bold">
                <span>总开支合计 (Summe Werbungskosten):</span>
                <span id="taxTotalWerbungskosten">0.00 €</span>
              </div>
            </div>
          </div>
        </div>

        <!-- 税务核算结果卡 -->
        <div class="mt-6 p-4 bg-slate-950 rounded-xl border border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-4">
          <div>
            <span class="text-xs text-slate-400 block font-medium">Anlage V 应税结果 (Einkünfte aus V+V)</span>
            <div id="taxFinalResult" class="text-2xl font-black font-mono text-emerald-400 mt-1">0.00 €</div>
            <p class="text-[11px] text-slate-500 mt-0.5">负数代表产生税务亏损（Steuerlicher Verlust），可直接冲抵当年工资所得税！</p>
          </div>
          <div class="text-right">
            <span class="text-xs text-slate-400 block font-medium">预计退税/(补税) 现金流影响</span>
            <div id="taxImpactVal" class="text-xl font-bold font-mono text-emerald-400 mt-1">0.00 €</div>
          </div>
        </div>

        <!-- 15% 维修红线警示条 (§ 6 Abs. 1 Nr. 1a EStG) -->
        <div class="mt-5 p-4 bg-slate-950/70 border border-slate-800 rounded-xl space-y-2">
          <div class="flex justify-between items-center text-xs">
            <span class="font-bold text-slate-300 flex items-center gap-1.5">
              <i class="fa-solid fa-triangle-exclamation text-amber-400"></i>
              <span>购房前 3 年维修 15% 资本化红线监控 (§ 6 Abs. 1 Nr. 1a EStG)</span>
            </span>
            <span id="tax15LimitRatio" class="font-mono text-amber-400 font-bold">0.0% / 15.0%</span>
          </div>
          <div class="w-full bg-slate-900 rounded-full h-2.5 overflow-hidden border border-slate-800">
            <div id="tax15LimitBar" class="bg-amber-400 h-full rounded-full transition-all duration-500" style="width: 0%"></div>
          </div>
          <div class="flex justify-between text-[11px] text-slate-500">
            <span>已发生维修总额: <b id="tax15Used" class="text-slate-300 font-mono">0.00 €</b></span>
            <span>法定上限红线额度: <b id="tax15Max" class="text-slate-300 font-mono">0.00 €</b></span>
          </div>
        </div>
      </div>
    </section>

  </main>

  <!-- ================= 弹窗集合 ================= -->

  <!-- 1. 新增房产弹窗 -->
  <div id="addPropertyModal" class="hidden fixed inset-0 z-50 bg-black/70 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-slate-900 border border-slate-800 rounded-2xl max-w-md w-full p-6 shadow-2xl space-y-4">
      <div class="flex justify-between items-center pb-3 border-b border-slate-800">
        <h3 class="text-base font-bold text-white flex items-center gap-2">
          <i class="fa-solid fa-plus text-sky-400"></i>
          <span>新增名下房产</span>
        </h3>
        <button onclick="app.closeAddPropertyModal()" class="text-slate-400 hover:text-white"><i class="fa-solid fa-xmark"></i></button>
      </div>
      <div class="space-y-3 text-xs">
        <div>
          <label class="block text-slate-400 mb-1">房产标识名称 (如: 杜塞市中心公寓)</label>
          <input id="newPropName" type="text" placeholder="Düsseldorf Bilk 2-Zimmer" class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-white">
        </div>
        <div>
          <label class="block text-slate-400 mb-1">净买入价格 (€)</label>
          <input id="newPropKaufpreis" type="number" step="1000" placeholder="180000" class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-white font-mono">
        </div>
        <div>
          <label class="block text-slate-400 mb-1">签约月冷租 (€)</label>
          <input id="newPropKaltmiete" type="number" step="10" placeholder="850" class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-white font-mono">
        </div>
      </div>
      <div class="flex justify-end gap-2 pt-3 border-t border-slate-800">
        <button onclick="app.closeAddPropertyModal()" class="px-4 py-2 bg-slate-800 text-slate-300 rounded-xl text-xs">取消</button>
        <button onclick="app.confirmAddProperty()" class="px-4 py-2 bg-sky-500 hover:bg-sky-400 text-white rounded-xl text-xs font-bold shadow">确认添加</button>
      </div>
    </div>
  </div>

  <!-- 2. 区间批量生成流水弹窗 -->
  <div id="batchGenerateModal" class="hidden fixed inset-0 z-50 bg-black/70 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-slate-900 border border-slate-800 rounded-2xl max-w-md w-full p-6 shadow-2xl space-y-4">
      <div class="flex justify-between items-center pb-3 border-b border-slate-800">
        <h3 class="text-base font-bold text-white flex items-center gap-2">
          <i class="fa-solid fa-calendar-days text-sky-400"></i>
          <span>按区间批量排布基准流水</span>
        </h3>
        <button onclick="app.closeBatchGenerateModal()" class="text-slate-400 hover:text-white"><i class="fa-solid fa-xmark"></i></button>
      </div>
      <p class="text-xs text-slate-400">设定起止区间与基准参数，系统将自动结合贷款契约连续排布月度账单。</p>
      
      <!-- 起止月份选择 -->
      <div class="grid grid-cols-2 gap-3 text-xs">
        <div>
          <label class="block text-slate-400 mb-1">起始月份 (Von)</label>
          <input id="batchStartMonth" type="month" value="2024-11" class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-white font-mono font-bold">
        </div>
        <div>
          <label class="block text-slate-400 mb-1">结束月份 (Bis)</label>
          <input id="batchEndMonth" type="month" value="2026-12" class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-white font-mono font-bold">
        </div>
      </div>

      <!-- 新增：批量排布时的基准参数（冷租、预缴杂费、物业费） -->
      <div class="p-3 bg-slate-950/70 border border-slate-800 rounded-xl space-y-2.5 text-xs">
        <div class="flex justify-between items-center">
          <span class="text-[11px] font-bold text-sky-400 uppercase tracking-wider">批量采用的运营基准参数</span>
          <span class="text-[10px] text-slate-500">已默认载入当前房产配置</span>
        </div>
        <div class="grid grid-cols-3 gap-2">
          <div>
            <label class="block text-slate-400 text-[10px] mb-1">签约冷租 (€)</label>
            <input id="batchInputKalt" type="number" step="10" class="w-full bg-slate-900 border border-slate-700 rounded px-2.5 py-1.5 text-emerald-400 font-mono font-bold text-xs focus:border-sky-500 focus:outline-none">
          </div>
          <div>
            <label class="block text-slate-400 text-[10px] mb-1">预缴杂费 (€)</label>
            <input id="batchInputNk" type="number" step="10" class="w-full bg-slate-900 border border-slate-700 rounded px-2.5 py-1.5 text-slate-100 font-mono text-xs focus:border-sky-500 focus:outline-none">
          </div>
          <div>
            <label class="block text-slate-400 text-[10px] mb-1">打款物业 (€)</label>
            <input id="batchInputHausgeld" type="number" step="1" class="w-full bg-slate-900 border border-slate-700 rounded px-2.5 py-1.5 text-rose-300 font-mono text-xs focus:border-sky-500 focus:outline-none">
          </div>
        </div>
      </div>

      <div class="p-3 bg-slate-950/70 border border-slate-800 rounded-xl space-y-2 text-xs">
        <label class="flex items-center gap-2 text-slate-300 cursor-pointer">
          <input id="batchOverwrite" type="checkbox" class="rounded bg-slate-900 border-slate-700 text-sky-500 focus:ring-0">
          <span>覆盖已有月份数据 (重置为基准)</span>
        </label>
        <p class="text-[11px] text-slate-500">若不勾选，系统将智能跳过已存在自定义维修或调整的月份。</p>
      </div>
      <div class="flex justify-end gap-2 pt-3 border-t border-slate-800">
        <button onclick="app.closeBatchGenerateModal()" class="px-4 py-2 bg-slate-800 text-slate-300 rounded-xl text-xs">取消</button>
        <button onclick="app.runBatchGenerate()" class="px-4 py-2 bg-sky-500 hover:bg-sky-400 text-white rounded-xl text-xs font-bold shadow">开始生成</button>
      </div>
    </div>
  </div>

  <!-- 3. 录入/修改单月收支弹窗 -->
  <div id="ledgerModal" class="hidden fixed inset-0 z-50 bg-black/70 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-slate-900 border border-slate-800 rounded-2xl max-w-lg w-full p-6 shadow-2xl space-y-4 max-h-[90vh] overflow-y-auto scrollbar-thin">
      <div class="flex justify-between items-center pb-3 border-b border-slate-800">
        <h3 id="ledgerModalTitle" class="text-base font-bold text-white flex items-center gap-2">
          <i class="fa-solid fa-pen-to-square text-sky-400"></i>
          <span>录入/修改月度收支记录</span>
        </h3>
        <button onclick="app.closeLedgerModal()" class="text-slate-400 hover:text-white"><i class="fa-solid fa-xmark"></i></button>
      </div>

      <div class="space-y-4 text-xs">
        <div>
          <label class="block text-slate-400 text-[11px] mb-1">记账月份 (Monat)</label>
          <input id="ledgerModalMonth" type="month" class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-white font-mono font-bold" onchange="app.onLedgerModalMonthChange(this.value)">
        </div>

        <!-- 1. 租金与额外收入 -->
        <div class="p-3 bg-slate-950/60 rounded-xl border border-slate-800 space-y-2">
          <span class="text-[11px] font-bold text-emerald-400 uppercase tracking-wider block">1. 租金与额外收入 (Miete & Einnahmen)</span>
          <div class="grid grid-cols-3 gap-2">
            <div>
              <label class="block text-slate-400 text-[10px] mb-1">冷租 (Kalt, €)</label>
              <input id="modalInputKalt" type="number" step="10" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-2 py-1.5 text-white font-mono font-bold">
            </div>
            <div>
              <label class="block text-slate-400 text-[10px] mb-1">预缴杂费 (NK, €)</label>
              <input id="modalInputNk" type="number" step="10" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-2 py-1.5 text-white font-mono">
            </div>
            <div>
              <label class="block text-emerald-400 text-[10px] mb-1 font-semibold">其他收入 (€)</label>
              <input id="modalInputOtherIncome" type="number" step="10" placeholder="如补缴" class="w-full bg-slate-900 border border-emerald-500/40 rounded-lg px-2 py-1.5 text-emerald-400 font-mono font-bold">
            </div>
          </div>
        </div>

        <!-- 2. 银行贷款供款与物业费 -->
        <div class="p-3 bg-slate-950/60 rounded-xl border border-slate-800 space-y-2">
          <span class="text-[11px] font-bold text-sky-400 uppercase tracking-wider block">2. 银行供款与物业费 (Darlehen & Hausgeld)</span>
          <div class="grid grid-cols-3 gap-2">
            <div>
              <label class="block text-rose-300 text-[10px] mb-1">利息 (Zins, €)</label>
              <input id="modalInputZins" type="number" step="1" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-2 py-1.5 text-rose-300 font-mono font-bold">
            </div>
            <div>
              <label class="block text-sky-300 text-[10px] mb-1">还本 (Tilgung, €)</label>
              <input id="modalInputTilgung" type="number" step="1" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-2 py-1.5 text-sky-300 font-mono font-bold">
            </div>
            <div>
              <label class="block text-rose-300 text-[10px] mb-1">打款物业 (Hausgeld, €)</label>
              <input id="modalInputHausgeld" type="number" step="1" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-2 py-1.5 text-rose-300 font-mono">
            </div>
          </div>
        </div>

        <!-- 3. 其他可变额外支出 -->
        <div class="p-3 bg-slate-950/60 rounded-xl border border-slate-800 space-y-2">
          <span class="text-[11px] font-bold text-amber-400 uppercase tracking-wider block">3. 可变额外支出 (Variable Ausgaben)</span>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
            <div>
              <label class="block text-rose-400 text-[10px] mb-1">维修修缮 (€)</label>
              <input id="modalInputReparatur" type="number" step="10" placeholder="0" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-2 py-1.5 text-white font-mono">
            </div>
            <div>
              <label class="block text-purple-400 text-[10px] mb-1">中介招租 (€)</label>
              <input id="modalInputMakler" type="number" step="10" placeholder="0" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-2 py-1.5 text-white font-mono">
            </div>
            <div>
              <label class="block text-amber-400 text-[10px] mb-1">购置物品 (€)</label>
              <input id="modalInputAnschaffung" type="number" step="10" placeholder="0" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-2 py-1.5 text-white font-mono">
            </div>
            <div>
              <label class="block text-slate-300 text-[10px] mb-1">其他支出 (€)</label>
              <input id="modalInputOtherExpense" type="number" step="10" placeholder="0" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-2 py-1.5 text-white font-mono">
            </div>
          </div>
        </div>

        <!-- 4. 备注说明 -->
        <div>
          <label class="block text-slate-400 text-[11px] mb-1">备注说明 (Notiz)</label>
          <input id="modalInputNote" type="text" placeholder="如: 租客更换花洒、退租结算等" class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-white">
        </div>
      </div>

      <div class="flex justify-end gap-2 pt-3 border-t border-slate-800">
        <button onclick="app.closeLedgerModal()" class="px-4 py-2 bg-slate-800 text-slate-300 rounded-xl text-xs">取消</button>
        <button onclick="app.saveLedgerModalEntry()" class="px-4 py-2 bg-sky-500 hover:bg-sky-400 text-white rounded-xl text-xs font-bold shadow">确认保存月结</button>
      </div>
    </div>
  </div>

  <!-- 4. 录入/修改物业年度决算弹窗 -->
  <div id="wegModal" class="hidden fixed inset-0 z-50 bg-black/70 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-slate-900 border border-slate-800 rounded-2xl max-w-lg w-full p-6 shadow-2xl space-y-4 max-h-[90vh] overflow-y-auto scrollbar-thin">
      <div class="flex justify-between items-center pb-3 border-b border-slate-800">
        <h3 id="wegModalTitle" class="text-base font-bold text-white flex items-center gap-2">
          <i class="fa-solid fa-file-invoice-dollar text-sky-400"></i>
          <span>录入物业年度决算 (WEG-Abrechnung)</span>
        </h3>
        <button onclick="app.closeWegModal()" class="text-slate-400 hover:text-white"><i class="fa-solid fa-xmark"></i></button>
      </div>

      <div class="space-y-4 text-xs">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-slate-400 text-[11px] mb-1">决算经济年度 (Wirtschaftsjahr)</label>
            <input id="wegInputYear" type="number" step="1" value="2024" class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-white font-mono font-bold" onchange="app.onWegYearChange()">
          </div>
          <div>
            <label class="block text-slate-400 text-[11px] mb-1">物业扣款/到账日 (Valuta)</label>
            <input id="wegInputValutaDate" type="date" value="2025-10-15" class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-white font-mono">
          </div>
        </div>

        <div class="p-3 bg-slate-950/60 rounded-xl border border-slate-800 space-y-2">
          <span class="text-[11px] font-bold text-sky-400 uppercase tracking-wider block">1. 决算单真实开支拆分 (Aufschlüsselung der Abrechnung)</span>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-slate-400 text-[11px] mb-1">1. 租客可分摊成本 (Umlagefähig, €)</label>
              <input id="wegInputUmlage" type="number" step="10" placeholder="2680" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-1.5 text-white font-mono" oninput="app.calcWegSummary()">
            </div>
            <div>
              <label class="block text-slate-400 text-[11px] mb-1">2. 不可分摊管理费 (Nicht umlagefähig, €)</label>
              <input id="wegInputNichtUmlage" type="number" step="10" placeholder="450" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-1.5 text-white font-mono">
            </div>
          </div>
          <div class="grid grid-cols-2 gap-3 pt-1">
            <div>
              <label class="block text-amber-200 text-[11px] mb-1 font-semibold">3. 维修基金全年存入 (Zuführung Rücklage, €)</label>
              <input id="wegInputRuecklageZufuehrung" type="number" step="10" value="420" placeholder="全年存入公维金总额" class="w-full bg-slate-900 border border-amber-500/40 rounded-lg px-3 py-1.5 text-amber-200 font-mono font-bold">
              <span class="text-[10px] text-slate-500 mt-0.5 block">纯储备沉淀，报税不可抵扣。</span>
            </div>
            <div>
              <label class="block text-amber-400 text-[11px] mb-1 font-semibold">4. 维修基金当年实际动用 (Entnahme, €)</label>
              <input id="wegInputRuecklageEntnahme" type="number" step="10" value="0" placeholder="用于大修实际花掉的金额" class="w-full bg-slate-900 border border-amber-500/40 rounded-lg px-3 py-1.5 text-amber-400 font-mono font-bold">
              <span class="text-[10px] text-slate-500 mt-0.5 block">核心税法：仅此项可在 Anlage V 抵税。</span>
            </div>
          </div>
        </div>

        <!-- 2. 房东与物业公司之间的差额结算 (与租客无关) -->
        <div class="p-3 bg-slate-950/60 rounded-xl border border-slate-800 space-y-2">
          <span class="text-[11px] font-bold text-rose-300 uppercase tracking-wider block">2. 房东与物业公司结算差额 (Abrechnungsspitze Hausgeld)</span>
          <div class="space-y-3">
            <div class="grid grid-cols-1 sm:grid-cols-12 gap-3 items-center">
              <div class="sm:col-span-5">
                <label class="block text-slate-400 text-[11px] mb-1 font-medium">结算类型 (Abrechnungsart)</label>
                <!-- 明确的选择切换：补缴还是退款 -->
                <select id="wegInputTotalDiffType" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-xs font-bold outline-none cursor-pointer focus:border-sky-500" onchange="app.updateWegDiffTypeVisual()">
                  <option value="pay" selected class="text-rose-400 font-bold">房东补缴 (Nachzahlung)</option>
                  <option value="refund" class="text-emerald-400 font-bold">物业退款 (Guthaben)</option>
                </select>
              </div>
              <div class="sm:col-span-7">
                <label class="block text-slate-400 text-[11px] mb-1 font-medium">结算金额 (€)</label>
                <input id="wegInputTotalDiff" type="number" step="0.01" min="0" value="120" placeholder="0.00" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-white font-mono font-bold text-sm focus:border-sky-500 focus:outline-none" oninput="app.updateWegDiffTypeVisual()">
              </div>
            </div>
            
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 bg-slate-900/80 p-2.5 rounded-lg border border-slate-800">
              <div id="wegDiffBadge" class="text-xs font-bold text-rose-400 font-mono">
                需向物业打款补缴: 120,00 €
              </div>
              <div class="text-[11px] text-slate-400">
                <span class="text-slate-300 font-medium">💡 说明：</span>房东与物业公司最终多退少补，与租客无关
              </div>
            </div>
          </div>
        </div>

        <div class="p-3 bg-slate-950/60 rounded-xl border border-slate-800 space-y-2">
          <span class="text-[11px] font-bold text-emerald-400 uppercase tracking-wider block">3. 最终租客对账 (Mieterabrechnung)</span>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-slate-400 text-[11px] mb-1">租客补缴到账/退款月份</label>
              <input id="wegInputMieterMonth" type="month" value="2025-11" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-1.5 text-sky-400 font-mono font-bold">
            </div>
            <div class="flex flex-col justify-end">
              <div class="flex justify-between text-[11px] text-slate-400">
                <span>当年租客已预缴杂费:</span>
                <b id="wegMieterPrepaid" class="text-white font-mono">0.00 €</b>
              </div>
              <div id="wegMieterResult" class="font-bold font-mono text-emerald-400 text-xs mt-1 text-right">+0.00 € (租客补缴)</div>
            </div>
          </div>
        </div>

        <div class="p-2 bg-slate-950/80 rounded-lg border border-slate-800">
          <label class="flex items-center gap-2 text-slate-300">
            <input id="wegAutoPost" type="checkbox" checked class="rounded bg-slate-900 border-slate-700 text-sky-500 focus:ring-0">
            <span>自动将差额记入指定月份收支账本 (根据收付实现制)</span>
          </label>
        </div>
      </div>

      <div class="flex justify-end gap-2 pt-3 border-t border-slate-800">
        <button onclick="app.closeWegModal()" class="px-4 py-2 bg-slate-800 text-slate-300 rounded-xl text-xs">取消</button>
        <button onclick="app.saveWegModalEntry()" class="px-4 py-2 bg-sky-500 hover:bg-sky-400 text-white rounded-xl text-xs font-bold shadow">确认保存决算</button>
      </div>
    </div>
  </div>

  <!-- 5. 数据覆盖确认弹窗 -->
  <div id="diffConfirmModal" class="hidden fixed inset-0 z-50 bg-black/70 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-slate-900 border border-slate-800 rounded-2xl max-w-md w-full p-6 shadow-2xl space-y-4">
      <div class="flex justify-between items-center pb-3 border-b border-slate-800">
        <h3 id="diffModalTitle" class="text-base font-bold text-amber-400 flex items-center gap-2">
          <i class="fa-solid fa-triangle-exclamation"></i>
          <span>数据覆盖确认</span>
        </h3>
        <button onclick="document.getElementById('diffConfirmModal').classList.add('hidden')" class="text-slate-400 hover:text-white"><i class="fa-solid fa-xmark"></i></button>
      </div>
      <div id="diffConfirmContent" class="space-y-3 text-xs"></div>
      <div class="flex justify-end gap-2 pt-3 border-t border-slate-800">
        <button onclick="document.getElementById('diffConfirmModal').classList.add('hidden')" class="px-4 py-2 bg-slate-800 text-slate-300 rounded-xl text-xs">取消</button>
        <button id="diffConfirmBtn" class="px-4 py-2 bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold rounded-xl text-xs shadow">确认覆盖</button>
      </div>
    </div>
  </div>

  <!-- 6. 智能补齐成果提示弹窗 -->
  <div id="catchUpRecapModal" class="hidden fixed inset-0 z-50 bg-black/70 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-slate-900 border border-slate-800 rounded-2xl max-w-md w-full p-6 shadow-2xl space-y-4">
      <div class="flex justify-between items-center pb-3 border-b border-slate-800">
        <h3 class="text-base font-bold text-emerald-400 flex items-center gap-2">
          <i class="fa-solid fa-circle-check"></i>
          <span>月度账单已智能补齐</span>
        </h3>
        <button onclick="app.closeCatchUpRecapModal()" class="text-slate-400 hover:text-white"><i class="fa-solid fa-xmark"></i></button>
      </div>
      <div id="catchUpRecapContent" class="space-y-3 text-xs text-slate-300"></div>
      <div class="flex justify-end pt-3 border-t border-slate-800">
        <button onclick="app.closeCatchUpRecapModal()" class="px-4 py-2 bg-sky-500 hover:bg-sky-400 text-white font-bold rounded-xl text-xs shadow">好的，了解</button>
      </div>
    </div>
  </div>

  <!-- 轻量全局 Toast 通知容器 -->
  <div id="toast" class="fixed bottom-5 right-5 z-50 transform translate-y-20 opacity-0 transition-all duration-300 bg-slate-900 border border-sky-500/40 text-slate-100 px-4 py-2.5 rounded-xl shadow-2xl flex items-center gap-2 text-xs font-medium">
    <i class="fa-solid fa-circle-check text-emerald-400 text-sm"></i>
    <span id="toastMsg">操作成功</span>
  </div>

  <!-- JavaScript 核心逻辑 -->
  <script>
    class RealEstateSystem {
      constructor() {
        this.currentPropertyId = 'prop-1';
        this.activeTab = 'ledger';
        this.ledgerSubView = 'monthly'; // 'monthly' | 'yearly'
        this.editingWegIndex = null;
        this.equityChartInstance = null;
        this.yearlyChartInstance = null;

        // 100% 精确复原您的真实房产 Wickrather Str. 35 核心数据档案
        this.portfolio = [
          {
            id: 'prop-1',
            name: 'Wickrather Str. 35',
            kaufpreis: 145000,
            gebaeudeAnteil: 80,     // 80% 建筑物折旧基数
            afaRate: 2.0,            // 2.0% 线性折旧
            notarDate: '2024-09-15', // 公证签约日
            uebergang: '2024-11-01', // 钥匙交付交接日 (Nutzen-Lasten-Wechsel)
            // 4类法定购房杂费拆解 (单位: €)
            kaufNkDetails: {
              grunderwerbsteuer: 9425, // 契税 (如 NRW 6.5%)
              notar: 2175,             // 公证处费用 (约 1.5%)
              makler: 5176.5,          // 购房中介费 (约 3.57%)
              grundbuch: 725           // 土地登记局费用 (约 0.5%)
            },
            kaltmiete: 820,          // 当月签约冷租
            nebenkostenVorausz: 180, // 当月租客预缴杂费
            hausgeld: 260,           // 当月打款物业费
            ruecklageAnteil: 35,     // 预估维修基金
            umlageAnteil: 175,       // 可转嫁运营成本
            loans: {
              loan1: {
                amount: 95000,
                rate: 3.65,
                tilgung: 2.00
              },
              loan2: {
                active: true,
                amount: 45000,
                rate: 1.25,
                tilgung: 2.50
              },
              loan3: {
                active: false,
                amount: 0,
                rate: 0,
                tilgung: 0
              }
            },
            wegSettlements: [
              {
                year: '2024',
                valutaDate: '2025-10-15',
                umlage: 2100,
                nichtUmlage: 420,
                ruecklageZufuehrung: 420,
                ruecklageEntnahme: 0,
                totalDiff: 80,
                mieterDiff: 2100,
                mieterMonth: '2025-11'
              }
            ],
            ledger: []
          }
        ];
      }

      init() {
        this.populateDefaultLedgerIfEmpty();
        this.renderPropertySelect();
        this.renderPortfolio();
        this.renderStammdaten();
        this.renderLedger();
        this.renderWegSettlement();
        this.renderTaxView();
        this.checkCatchUpNeeded();
      }

      formatCurrency(num) {
        return (num || 0).toLocaleString('de-DE', {
          minimumFractionDigits: 2,
          maximumFractionDigits: 2
        }) + ' €';
      }

      showToast(msg) {
        const toast = document.getElementById('toast');
        const text = document.getElementById('toastMsg');
        text.innerText = msg;
        toast.classList.remove('translate-y-20', 'opacity-0');
        setTimeout(() => {
          toast.classList.add('translate-y-20', 'opacity-0');
        }, 2600);
      }

      getCurrentProperty() {
        return this.portfolio.find(p => p.id === this.currentPropertyId) || this.portfolio[0];
      }

      renderPropertySelect() {
        const sel = document.getElementById('propertySelect');
        if (!sel) return;
        sel.innerHTML = this.portfolio.map(p => `
          <option value="${p.id}" ${p.id === this.currentPropertyId ? 'selected' : ''}>${p.name}</option>
        `).join('');
      }

      switchProperty(propId) {
        this.currentPropertyId = propId;
        this.populateDefaultLedgerIfEmpty();
        this.renderPortfolio();
        this.renderStammdaten();
        this.renderLedger();
        this.renderWegSettlement();
        this.renderTaxView();
        this.checkCatchUpNeeded();
        this.showToast(`已切换至: ${this.getCurrentProperty().name}`);
      }

      switchTab(tabId) {
        this.activeTab = tabId;
        ['portfolio', 'stammdaten', 'ledger', 'weg', 'tax'].forEach(t => {
          const btn = document.getElementById(`tab-${t}`);
          const view = document.getElementById(`view-${t}`);
          if (btn && view) {
            if (t === tabId) {
              btn.className = 'tab-btn px-4 py-2 rounded-xl text-xs font-bold transition flex items-center gap-2 text-sky-400 bg-slate-800/80 border border-slate-700/80';
              view.classList.remove('hidden');
            } else {
              btn.className = 'tab-btn px-4 py-2 rounded-xl text-xs font-medium transition flex items-center gap-2 text-slate-400 hover:text-slate-200 hover:bg-slate-850';
              view.classList.add('hidden');
            }
          }
        });

        if (tabId === 'portfolio') {
          setTimeout(() => this.renderEquityChart(), 50);
        } else if (tabId === 'ledger') {
          this.renderLedger();
        } else if (tabId === 'weg') {
          this.renderWegSettlement();
        } else if (tabId === 'tax') {
          this.renderTaxView();
        }
      }

      // ================= 板块 1: 资产大盘 (Portfolio Overview) =================
      renderPortfolio() {
        const p = this.getCurrentProperty();
        const totalAssetVal = p.kaufpreis;
        const totalNk = (p.kaufNkDetails?.grunderwerbsteuer || 0) +
                        (p.kaufNkDetails?.notar || 0) +
                        (p.kaufNkDetails?.makler || 0) +
                        (p.kaufNkDetails?.grundbuch || 0);
        const totalCost = p.kaufpreis + totalNk;

        // 计算三笔贷款初始总负债
        let totalInitLoan = (p.loans.loan1?.amount || 0);
        if (p.loans.loan2 && p.loans.loan2.active) totalInitLoan += (p.loans.loan2.amount || 0);
        if (p.loans.loan3 && p.loans.loan3.active) totalInitLoan += (p.loans.loan3.amount || 0);

        let curDebt = 0;
        if (p.ledger.length > 0) {
          let paidTilgung = 0;
          p.ledger.forEach(item => { paidTilgung += (item.tilgung || 0); });
          curDebt = Math.max(0, totalInitLoan - paidTilgung);
        } else {
          curDebt = totalInitLoan;
        }

        const equity = totalAssetVal - curDebt;
        const grossYield = ((p.kaltmiete * 12) / p.kaufpreis) * 100;

        let cumulativeCf = 0;
        p.ledger.forEach(item => {
          const inTotal = (item.kalt || 0) + (item.nk || 0) + (item.otherIncome || 0);
          const outTotal = (item.zins || 0) + (item.tilgung || 0) + (item.hausgeld || 0) + 
                           (item.reparatur || 0) + (item.makler || 0) + (item.anschaffung || 0) + (item.otherExpense || item.other || 0);
          cumulativeCf += (inTotal - outTotal);
        });

        document.getElementById('statTotalAssetVal').innerText = this.formatCurrency(totalAssetVal);
        document.getElementById('statTotalCost').innerText = this.formatCurrency(totalCost);
        document.getElementById('statTotalDebt').innerText = this.formatCurrency(curDebt);
        document.getElementById('statTotalEquity').innerText = this.formatCurrency(equity);
        document.getElementById('statMonthlyKalt').innerText = this.formatCurrency(p.kaltmiete);
        document.getElementById('statGrossYield').innerText = grossYield.toFixed(2) + ' %';
        
        const cfEl = document.getElementById('statCumulativeCashflow');
        cfEl.innerText = (cumulativeCf >= 0 ? '+' : '') + this.formatCurrency(cumulativeCf);
        cfEl.className = `text-2xl font-black mt-1 font-mono ${cumulativeCf >= 0 ? 'text-emerald-400' : 'text-rose-400'}`;
        document.getElementById('statRecordedMonths').innerText = p.ledger.length;

        // 安全指标
        const ltv = totalAssetVal > 0 ? (curDebt / totalAssetVal) * 100 : 0;
        document.getElementById('metricLTV').innerText = ltv.toFixed(1) + ' %';
        document.getElementById('barLTV').style.width = `${Math.min(100, ltv)}%`;

        let totalMonthlyAnnuitaet = 0;
        if (p.loans.loan1) {
          totalMonthlyAnnuitaet += p.loans.loan1.amount * ((p.loans.loan1.rate + p.loans.loan1.tilgung) / 100) / 12;
        }
        if (p.loans.loan2 && p.loans.loan2.active) {
          totalMonthlyAnnuitaet += p.loans.loan2.amount * ((p.loans.loan2.rate + p.loans.loan2.tilgung) / 100) / 12;
        }
        if (p.loans.loan3 && p.loans.loan3.active) {
          totalMonthlyAnnuitaet += p.loans.loan3.amount * ((p.loans.loan3.rate + p.loans.loan3.tilgung) / 100) / 12;
        }

        const dscr = totalMonthlyAnnuitaet > 0 ? (p.kaltmiete / totalMonthlyAnnuitaet) : 2.5;
        document.getElementById('metricDSCR').innerText = dscr.toFixed(2) + 'x';
        document.getElementById('barDSCR').style.width = `${Math.min(100, (dscr / 2) * 100)}%`;

        document.getElementById('statPropertyCount').innerText = `${this.portfolio.length} 套`;

        this.renderEquityChart();
      }

      renderEquityChart() {
        const ctx = document.getElementById('equityChart');
        if (!ctx) return;
        if (this.equityChartInstance) this.equityChartInstance.destroy();

        const p = this.getCurrentProperty();
        const years = [0, 1, 2, 3, 4, 5, 7, 10, 15];
        const labels = years.map(y => y === 0 ? '买入交割' : `第 ${y} 年`);

        // 合并三笔贷款多期摊销预测
        const loansToAmortize = [];
        if (p.loans.loan1) {
          loansToAmortize.push({
            bal: p.loans.loan1.amount,
            rate: p.loans.loan1.rate / 100,
            annuitaet: p.loans.loan1.amount * ((p.loans.loan1.rate + p.loans.loan1.tilgung) / 100)
          });
        }
        if (p.loans.loan2 && p.loans.loan2.active) {
          loansToAmortize.push({
            bal: p.loans.loan2.amount,
            rate: p.loans.loan2.rate / 100,
            annuitaet: p.loans.loan2.amount * ((p.loans.loan2.rate + p.loans.loan2.tilgung) / 100)
          });
        }
        if (p.loans.loan3 && p.loans.loan3.active) {
          loansToAmortize.push({
            bal: p.loans.loan3.amount,
            rate: p.loans.loan3.rate / 100,
            annuitaet: p.loans.loan3.amount * ((p.loans.loan3.rate + p.loans.loan3.tilgung) / 100)
          });
        }

        const debtCurve = [];
        const equityCurve = [];

        years.forEach(yr => {
          let totalRemainingDebt = 0;
          loansToAmortize.forEach(ln => {
            let tempBal = ln.bal;
            for (let i = 0; i < yr * 12; i++) {
              const zins = (tempBal * ln.rate) / 12;
              const tilg = (ln.annuitaet / 12) - zins;
              tempBal = Math.max(0, tempBal - tilg);
            }
            totalRemainingDebt += tempBal;
          });

          debtCurve.push(Math.round(totalRemainingDebt));
          equityCurve.push(Math.round(p.kaufpreis - totalRemainingDebt));
        });

        this.equityChartInstance = new Chart(ctx, {
          type: 'line',
          data: {
            labels: labels,
            datasets: [
              {
                label: '纯本金净资产 (Eigenkapital)',
                data: equityCurve,
                borderColor: '#38bdf8',
                backgroundColor: 'rgba(56, 189, 248, 0.15)',
                fill: true,
                tension: 0.3,
                borderWidth: 2.5,
                pointRadius: 3
              },
              {
                label: '剩余贷款总负债 (Restschuld)',
                data: debtCurve,
                borderColor: '#f43f5e',
                backgroundColor: 'transparent',
                borderDash: [5, 5],
                tension: 0.3,
                borderWidth: 2,
                pointRadius: 2
              }
            ]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: {
                labels: {
                  color: '#94a3b8',
                  font: { size: 11, family: 'Inter' }
                }
              }
            },
            scales: {
              x: {
                ticks: { color: '#64748b', font: { size: 10 } },
                grid: { color: '#1e293b' }
              },
              y: {
                ticks: {
                  color: '#64748b',
                  font: { size: 10, family: 'Roboto Mono' },
                  callback: (val) => (val / 1000) + 'k €'
                },
                grid: { color: '#1e293b' }
              }
            }
          }
        });
      }

      // ================= 板块 2: 单房参数 (Stammdaten) =================
      renderStammdaten() {
        const p = this.getCurrentProperty();
        document.getElementById('stammPropTitle').innerText = `${p.name} - 参数与契约档案`;
        document.getElementById('inputPropName').value = p.name;
        document.getElementById('inputPropNotarDate').value = p.notarDate || '';
        document.getElementById('inputPropUebergang').value = p.uebergang;
        document.getElementById('inputPropKaufpreis').value = p.kaufpreis;
        document.getElementById('inputPropGebaeudeAnteil').value = p.gebaeudeAnteil;
        document.getElementById('inputPropAfaRate').value = p.afaRate;

        // 回填 4 类购房杂费
        const nk = p.kaufNkDetails || {};
        document.getElementById('inputNkGrunderwerb').value = nk.grunderwerbsteuer ?? Math.round(p.kaufpreis * 0.065);
        document.getElementById('inputNkNotar').value = nk.notar ?? Math.round(p.kaufpreis * 0.015);
        document.getElementById('inputNkMakler').value = nk.makler ?? Math.round(p.kaufpreis * 0.0357);
        document.getElementById('inputNkGrundbuch').value = nk.grundbuch ?? Math.round(p.kaufpreis * 0.005);
        this.calcPurchaseCosts();

        document.getElementById('inputLoan1Amount').value = p.loans.loan1.amount;
        document.getElementById('inputLoan1Rate').value = p.loans.loan1.rate;
        document.getElementById('inputLoan1Tilgung').value = p.loans.loan1.tilgung;

        const l2Active = p.loans.loan2 && p.loans.loan2.active;
        document.getElementById('inputLoan2Active').checked = !!l2Active;
        this.toggleLoanFieldVisuals(2, !!l2Active);
        if (p.loans.loan2) {
          document.getElementById('inputLoan2Amount').value = p.loans.loan2.amount;
          document.getElementById('inputLoan2Rate').value = p.loans.loan2.rate;
          document.getElementById('inputLoan2Tilgung').value = p.loans.loan2.tilgung;
        }

        const l3Active = p.loans.loan3 && p.loans.loan3.active;
        document.getElementById('inputLoan3Active').checked = !!l3Active;
        this.toggleLoanFieldVisuals(3, !!l3Active);
        if (p.loans.loan3) {
          document.getElementById('inputLoan3Amount').value = p.loans.loan3.amount;
          document.getElementById('inputLoan3Rate').value = p.loans.loan3.rate;
          document.getElementById('inputLoan3Tilgung').value = p.loans.loan3.tilgung;
        }

        document.getElementById('inputPropKaltmiete').value = p.kaltmiete;
        document.getElementById('inputPropNk').value = p.nebenkostenVorausz;
        document.getElementById('inputPropHausgeld').value = p.hausgeld;

        document.getElementById('displayRuecklageAnteils').innerText = `约 ${p.ruecklageAnteil.toFixed(2)} €`;
        document.getElementById('displayUmlageAnteils').innerText = `约 ${p.umlageAnteil.toFixed(2)} €`;
      }

      calcPurchaseCosts() {
        const kaufpreis = parseFloat(document.getElementById('inputPropKaufpreis').value) || 0;
        const g = parseFloat(document.getElementById('inputNkGrunderwerb').value) || 0;
        const n = parseFloat(document.getElementById('inputNkNotar').value) || 0;
        const m = parseFloat(document.getElementById('inputNkMakler').value) || 0;
        const gb = parseFloat(document.getElementById('inputNkGrundbuch').value) || 0;

        const totalNk = g + n + m + gb;
        const pct = kaufpreis > 0 ? (totalNk / kaufpreis) * 100 : 0;

        const el = document.getElementById('displayTotalKaufNk');
        if (el) {
          el.innerText = `${this.formatCurrency(totalNk)} (${pct.toFixed(2)}%)`;
        }
      }

      toggleLoanActive(loanNum, active) {
        this.toggleLoanFieldVisuals(loanNum, active);
      }

      toggleLoanFieldVisuals(loanNum, active) {
        const fields = document.getElementById(`loan${loanNum}Fields`);
        if (fields) {
          if (active) {
            fields.classList.remove('opacity-50', 'pointer-events-none');
          } else {
            fields.classList.add('opacity-50', 'pointer-events-none');
          }
        }
      }

      saveCurrentPropertyStammdaten() {
        const p = this.getCurrentProperty();
        p.name = document.getElementById('inputPropName').value;
        p.notarDate = document.getElementById('inputPropNotarDate').value;
        p.uebergang = document.getElementById('inputPropUebergang').value;
        p.kaufpreis = parseFloat(document.getElementById('inputPropKaufpreis').value) || 0;
        p.gebaeudeAnteil = parseFloat(document.getElementById('inputPropGebaeudeAnteil').value) || 0;
        p.afaRate = parseFloat(document.getElementById('inputPropAfaRate').value) || 2.0;

        // 保存 4 类杂费详细数据
        p.kaufNkDetails = {
          grunderwerbsteuer: parseFloat(document.getElementById('inputNkGrunderwerb').value) || 0,
          notar: parseFloat(document.getElementById('inputNkNotar').value) || 0,
          makler: parseFloat(document.getElementById('inputNkMakler').value) || 0,
          grundbuch: parseFloat(document.getElementById('inputNkGrundbuch').value) || 0
        };

        p.loans.loan1.amount = parseFloat(document.getElementById('inputLoan1Amount').value) || 0;
        p.loans.loan1.rate = parseFloat(document.getElementById('inputLoan1Rate').value) || 0;
        p.loans.loan1.tilgung = parseFloat(document.getElementById('inputLoan1Tilgung').value) || 0;

        const l2Active = document.getElementById('inputLoan2Active').checked;
        p.loans.loan2 = {
          active: l2Active,
          amount: parseFloat(document.getElementById('inputLoan2Amount').value) || 0,
          rate: parseFloat(document.getElementById('inputLoan2Rate').value) || 0,
          tilgung: parseFloat(document.getElementById('inputLoan2Tilgung').value) || 0
        };

        const l3Active = document.getElementById('inputLoan3Active').checked;
        p.loans.loan3 = {
          active: l3Active,
          amount: parseFloat(document.getElementById('inputLoan3Amount').value) || 0,
          rate: parseFloat(document.getElementById('inputLoan3Rate').value) || 0,
          tilgung: parseFloat(document.getElementById('inputLoan3Tilgung').value) || 0
        };

        p.kaltmiete = parseFloat(document.getElementById('inputPropKaltmiete').value) || 0;
        p.nebenkostenVorausz = parseFloat(document.getElementById('inputPropNk').value) || 0;
        p.hausgeld = parseFloat(document.getElementById('inputPropHausgeld').value) || 0;

        this.renderPropertySelect();
        this.renderPortfolio();
        this.renderLedger();
        this.renderTaxView();
        this.showToast('房产核心参数与3笔贷款契约设置已更新成功！');
      }

      // ================= 板块 3: 收支账本与方案 B 年度看板 =================
      switchLedgerSubView(view) {
        this.ledgerSubView = view;
        const mBtn = document.getElementById('viewToggleMonthlyBtn');
        const yBtn = document.getElementById('viewToggleYearlyBtn');
        const mCont = document.getElementById('ledgerMonthlyContainer');
        const yCont = document.getElementById('ledgerYearlyContainer');

        if (view === 'monthly') {
          mBtn.className = 'px-3 py-1.5 rounded-lg font-bold transition flex items-center gap-1.5 bg-slate-800 text-sky-400 shadow-sm';
          yBtn.className = 'px-3 py-1.5 rounded-lg font-medium transition flex items-center gap-1.5 text-slate-400 hover:text-slate-200';
          mCont.classList.remove('hidden');
          yCont.classList.add('hidden');
          this.renderLedger();
        } else {
          yBtn.className = 'px-3 py-1.5 rounded-lg font-bold transition flex items-center gap-1.5 bg-slate-800 text-sky-400 shadow-sm';
          mBtn.className = 'px-3 py-1.5 rounded-lg font-medium transition flex items-center gap-1.5 text-slate-400 hover:text-slate-200';
          yCont.classList.remove('hidden');
          mCont.classList.add('hidden');
          this.renderYearlyDashboard();
        }
      }

      renderLedger() {
        const p = this.getCurrentProperty();
        const tbody = document.getElementById('ledgerTableBody');
        const sumRow = document.getElementById('ledgerSummaryRow');
        if (!tbody || !sumRow) return;

        p.ledger.sort((a, b) => a.month.localeCompare(b.month));

        let sumKalt = 0, sumNk = 0, sumOtherIncome = 0;
        let sumZins = 0, sumTilgung = 0, sumHausgeld = 0;
        let sumRep = 0, sumMakler = 0, sumAnschaffung = 0, sumOtherExpense = 0, sumNettoCf = 0;

        let rowsHtml = '';
        p.ledger.forEach(item => {
          const otherInc = item.otherIncome || 0;
          const otherExp = item.otherExpense !== undefined ? item.otherExpense : (item.other > 0 ? item.other : 0);

          const inTotal = (item.kalt || 0) + (item.nk || 0) + otherInc;
          const outTotal = (item.zins || 0) + (item.tilgung || 0) + (item.hausgeld || 0) + 
                           (item.reparatur || 0) + (item.makler || 0) + (item.anschaffung || 0) + otherExp;
          const cf = inTotal - outTotal;

          sumKalt += (item.kalt || 0);
          sumNk += (item.nk || 0);
          sumOtherIncome += otherInc;
          sumZins += (item.zins || 0);
          sumTilgung += (item.tilgung || 0);
          sumHausgeld += (item.hausgeld || 0);
          sumRep += (item.reparatur || 0);
          sumMakler += (item.makler || 0);
          sumAnschaffung += (item.anschaffung || 0);
          sumOtherExpense += otherExp;
          sumNettoCf += cf;

          const cfColor = cf >= 0 ? 'text-emerald-400' : 'text-rose-400';

          rowsHtml += `
            <tr class="hover:bg-slate-800/40 transition whitespace-nowrap">
              <td class="p-3 sticky left-0 z-10 bg-slate-950 font-bold text-white shadow-[2px_0_5px_-2px_rgba(0,0,0,0.5)] whitespace-nowrap">
                ${item.month}
              </td>
              <td class="p-3 text-right text-white font-bold whitespace-nowrap">${this.formatCurrency(item.kalt)}</td>
              <td class="p-3 text-right text-slate-100 font-semibold whitespace-nowrap">${this.formatCurrency(item.nk)}</td>
              <td class="p-3 text-right text-emerald-400 font-bold whitespace-nowrap">${otherInc > 0 ? '+' + this.formatCurrency(otherInc) : '-'}</td>
              <td class="p-3 text-right text-rose-300 font-bold whitespace-nowrap">${this.formatCurrency(item.zins)}</td>
              <td class="p-3 text-right text-sky-300 font-bold whitespace-nowrap">${this.formatCurrency(item.tilgung)}</td>
              <td class="p-3 text-right text-rose-300 font-bold whitespace-nowrap">${this.formatCurrency(item.hausgeld)}</td>
              <td class="p-3 text-right text-rose-400 font-bold whitespace-nowrap">${item.reparatur ? this.formatCurrency(item.reparatur) : '-'}</td>
              <td class="p-3 text-right text-purple-300 font-bold whitespace-nowrap">${item.makler ? this.formatCurrency(item.makler) : '-'}</td>
              <td class="p-3 text-right text-amber-300 font-bold whitespace-nowrap">${item.anschaffung ? this.formatCurrency(item.anschaffung) : '-'}</td>
              <td class="p-3 text-right text-slate-300 font-semibold whitespace-nowrap" title="${item.note || ''}">${otherExp > 0 ? this.formatCurrency(otherExp) : '-'}</td>
              <td class="p-3 text-right font-black ${cfColor} whitespace-nowrap text-xs">${cf >= 0 ? '+' : ''}${this.formatCurrency(cf)}</td>
              <td class="p-3 text-center whitespace-nowrap">
                <div class="flex items-center justify-center gap-1.5">
                  <button onclick="app.editLedgerEntry('${item.month}')" title="修改此月" class="p-1 px-2 rounded bg-slate-800 hover:bg-sky-900 text-sky-400 text-xs transition">
                    <i class="fa-solid fa-pen"></i>
                  </button>
                  <button onclick="app.deleteLedgerEntry('${item.month}')" title="删除此月" class="p-1 px-2 rounded bg-slate-800 hover:bg-rose-950 text-rose-400 text-xs transition">
                    <i class="fa-solid fa-trash-can"></i>
                  </button>
                </div>
              </td>
            </tr>
          `;
        });

        tbody.innerHTML = rowsHtml || `<tr><td colspan="13" class="p-6 text-center text-slate-500 font-sans">暂无收支流水记录。</td></tr>`;

        const totalCfColor = sumNettoCf >= 0 ? 'text-emerald-400' : 'text-rose-400';

        sumRow.innerHTML = `
          <tr class="whitespace-nowrap">
            <td class="p-3 sticky left-0 z-20 bg-slate-900 shadow-[2px_0_5px_-2px_rgba(0,0,0,0.5)] text-white font-bold whitespace-nowrap">
              ∑ 汇总 (${p.ledger.length}月)
            </td>
            <td class="p-3 text-right text-white whitespace-nowrap">${this.formatCurrency(sumKalt)}</td>
            <td class="p-3 text-right text-slate-300 whitespace-nowrap">${this.formatCurrency(sumNk)}</td>
            <td class="p-3 text-right text-emerald-400 whitespace-nowrap">${sumOtherIncome > 0 ? '+' + this.formatCurrency(sumOtherIncome) : '-'}</td>
            <td class="p-3 text-right text-rose-300 whitespace-nowrap">${this.formatCurrency(sumZins)}</td>
            <td class="p-3 text-right text-sky-300 whitespace-nowrap">${this.formatCurrency(sumTilgung)}</td>
            <td class="p-3 text-right text-rose-300 whitespace-nowrap">${this.formatCurrency(sumHausgeld)}</td>
            <td class="p-3 text-right text-rose-400 whitespace-nowrap">${this.formatCurrency(sumRep)}</td>
            <td class="p-3 text-right text-purple-400 whitespace-nowrap">${this.formatCurrency(sumMakler)}</td>
            <td class="p-3 text-right text-amber-400 whitespace-nowrap">${this.formatCurrency(sumAnschaffung)}</td>
            <td class="p-3 text-right text-slate-300 whitespace-nowrap">${sumOtherExpense > 0 ? this.formatCurrency(sumOtherExpense) : '-'}</td>
            <td class="p-3 text-right font-black ${totalCfColor} text-xs whitespace-nowrap">${sumNettoCf >= 0 ? '+' : ''}${this.formatCurrency(sumNettoCf)}</td>
            <td class="p-3 text-center text-slate-400 text-[10px] whitespace-nowrap">合计核算</td>
          </tr>
        `;
      }

      populateDefaultLedgerIfEmpty() {
        const p = this.getCurrentProperty();
        if (p.ledger.length === 0) {
          const start = new Date(2024, 10, 1); // 2024-11
          const now = new Date(2026, 10, 1);   // 2026-11
          let d = new Date(start);
          let loanBalance = p.loans.loan1.amount;

          while (d <= now) {
            const y = d.getFullYear();
            const m = String(d.getMonth() + 1).padStart(2, '0');
            const mKey = `${y}-${m}`;

            const zinsRate = p.loans.loan1.rate / 100;
            const annuitaet = p.loans.loan1.amount * ((p.loans.loan1.rate + p.loans.loan1.tilgung) / 100) / 12;
            const monthlyZins = (loanBalance * zinsRate) / 12;
            const monthlyTilgung = annuitaet - monthlyZins;
            loanBalance = Math.max(0, loanBalance - monthlyTilgung);

            p.ledger.push({
              month: mKey,
              kalt: p.kaltmiete,
              nk: p.nebenkostenVorausz,
              otherIncome: 0,
              zins: Math.round(monthlyZins * 100) / 100,
              tilgung: Math.round(monthlyTilgung * 100) / 100,
              hausgeld: p.hausgeld,
              reparatur: 0,
              makler: 0,
              anschaffung: 0,
              otherExpense: 0,
              note: '合同基准月结'
            });
            d.setMonth(d.getMonth() + 1);
          }
        }
      }

      // 渲染年度总览与多年度横向对比看板 (v3.5 精确色彩对齐)
      renderYearlyDashboard() {
        const p = this.getCurrentProperty();
        const table = document.getElementById('yearlyComparisonTable');
        if (!table) return;

        const yearsSet = new Set();
        p.ledger.forEach(item => {
          if (item.month) yearsSet.add(item.month.substring(0, 4));
        });
        const years = Array.from(yearsSet).sort();

        if (years.length === 0) {
          table.innerHTML = `<tr><td class="p-6 text-center text-slate-500 font-sans">暂无收支流水记录。</td></tr>`;
          return;
        }

        const statsByYear = {};
        years.forEach(yr => {
          statsByYear[yr] = {
            monthsCount: 0,
            kalt: 0,
            nk: 0,
            otherIncome: 0,
            zins: 0,
            tilgung: 0,
            hausgeld: 0,
            reparatur: 0,
            makler: 0,
            anschaffung: 0,
            otherExpense: 0,
            nettoCf: 0
          };
        });

        p.ledger.forEach(item => {
          const yr = item.month.substring(0, 4);
          if (statsByYear[yr]) {
            const otherInc = item.otherIncome || 0;
            const otherExp = item.otherExpense !== undefined ? item.otherExpense : (item.other > 0 ? item.other : 0);

            const inTotal = (item.kalt || 0) + (item.nk || 0) + otherInc;
            const outTotal = (item.zins || 0) + (item.tilgung || 0) + (item.hausgeld || 0) + (item.reparatur || 0) + (item.makler || 0) + (item.anschaffung || 0) + otherExp;
            const cf = inTotal - outTotal;

            statsByYear[yr].monthsCount += 1;
            statsByYear[yr].kalt += (item.kalt || 0);
            statsByYear[yr].nk += (item.nk || 0);
            statsByYear[yr].otherIncome += otherInc;
            statsByYear[yr].zins += (item.zins || 0);
            statsByYear[yr].tilgung += (item.tilgung || 0);
            statsByYear[yr].hausgeld += (item.hausgeld || 0);
            statsByYear[yr].reparatur += (item.reparatur || 0);
            statsByYear[yr].makler += (item.makler || 0);
            statsByYear[yr].anschaffung += (item.anschaffung || 0);
            statsByYear[yr].otherExpense += otherExp;
            statsByYear[yr].nettoCf += cf;
          }
        });

        // 严格与月度流水表格的科目文字色彩 1:1 对齐
        const rowsConfig = [
          { label: '已记账月数', key: 'monthsCount', isCurrency: false, labelColorClass: 'text-sky-400 font-semibold', colorClass: 'text-sky-300 font-bold' },
          { label: '冷租收入总额 (Kaltmiete)', key: 'kalt', isCurrency: true, labelColorClass: 'text-white font-semibold', colorClass: 'text-slate-100 font-bold' },
          { label: '租客预缴杂费 (NK-Vorausz.)', key: 'nk', isCurrency: true, labelColorClass: 'text-slate-100 font-semibold', colorClass: 'text-slate-300' },
          { label: '其他收入 (Sonst. Einnahmen)', key: 'otherIncome', isCurrency: true, labelColorClass: 'text-emerald-400 font-semibold', colorClass: 'text-emerald-400 font-bold' },
          { label: '银行利息支出 (Zinsen)', key: 'zins', isCurrency: true, labelColorClass: 'text-rose-300 font-semibold', colorClass: 'text-rose-300' },
          { label: '已偿还贷款本金 (Tilgung)', key: 'tilgung', isCurrency: true, labelColorClass: 'text-sky-300 font-semibold', colorClass: 'text-sky-300 font-bold' },
          { label: '物业费总支出 (Hausgeld)', key: 'hausgeld', isCurrency: true, labelColorClass: 'text-rose-300 font-semibold', colorClass: 'text-rose-300' },
          { label: '房屋维修修缮费 (Reparatur)', key: 'reparatur', isCurrency: true, labelColorClass: 'text-rose-400 font-semibold', colorClass: 'text-rose-400 font-semibold' },
          { label: '中介招租费用 (Makler)', key: 'makler', isCurrency: true, labelColorClass: 'text-purple-400 font-semibold', colorClass: 'text-purple-400 font-semibold' },
          { label: '购置物品支出 (Anschaffung)', key: 'anschaffung', isCurrency: true, labelColorClass: 'text-amber-400 font-semibold', colorClass: 'text-amber-400' },
          { label: '其他杂项支出 (Sonst. Ausgaben)', key: 'otherExpense', isCurrency: true, labelColorClass: 'text-slate-300 font-semibold', colorClass: 'text-slate-300' },
          { label: '年度净现金流 (Netto-Cashflow)', key: 'nettoCf', isCurrency: true, labelColorClass: 'text-white font-bold', isTotalRow: true }
        ];

        let tableHtml = `
          <thead>
            <tr class="bg-slate-950 text-slate-400 border-b border-slate-800 text-[11px] whitespace-nowrap">
              <th class="p-3 sticky left-0 z-10 bg-slate-950 shadow-[2px_0_5px_-2px_rgba(0,0,0,0.5)] min-w-[200px]">财务科目 / 项目</th>
              ${years.map(yr => `
                <th class="p-3 text-right min-w-[140px] text-white font-bold text-xs">
                  ${yr} 年 ${statsByYear[yr].monthsCount < 12 ? `<span class="text-[10px] text-amber-400 font-normal">(${statsByYear[yr].monthsCount}月)</span>` : '<span class="text-[10px] text-slate-400 font-normal">(全年)</span>'}
                </th>
              `).join('')}
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800/60 font-medium font-mono text-[11px]">
        `;

        rowsConfig.forEach(row => {
          tableHtml += `
            <tr class="hover:bg-slate-800/40 transition whitespace-nowrap ${row.isTotalRow ? 'bg-slate-950 font-bold border-t-2 border-sky-500/40' : ''}">
              <td class="p-3 sticky left-0 z-10 ${row.isTotalRow ? 'bg-slate-950' : 'bg-slate-900'} ${row.labelColorClass || 'text-slate-300'} shadow-[2px_0_5px_-2px_rgba(0,0,0,0.5)] whitespace-nowrap">
                ${row.label}
              </td>
              ${years.map(yr => {
                const val = statsByYear[yr][row.key];

                if (row.isTotalRow) {
                  const cfClass = val >= 0 ? 'text-emerald-400' : 'text-rose-400';
                  return `<td class="p-3 text-right font-black ${cfClass} text-sm whitespace-nowrap">${val >= 0 ? '+' : ''}${this.formatCurrency(val)}</td>`;
                }

                const display = row.isCurrency ? (val ? this.formatCurrency(val) : '-') : `${val} 个月`;
                return `<td class="p-3 text-right ${row.colorClass} whitespace-nowrap">${display}</td>`;
              }).join('')}
            </tr>
          `;
        });

        tableHtml += `</tbody>`;
        table.innerHTML = tableHtml;

        // 渲染柱状对比图与洞察卡片
        this.renderYearlyCharts(years, statsByYear);
        this.renderYearlyInsights(years, statsByYear);
      }

      renderYearlyCharts(years, stats) {
        const ctx = document.getElementById('yearlyTrendsChart');
        if (!ctx) return;
        if (this.yearlyChartInstance) this.yearlyChartInstance.destroy();

        // X 轴按科目划分
        const categories = [
          { label: '净现金流', key: 'nettoCf' },
          { label: '本金还款', key: 'tilgung' },
          { label: '其他收入', key: 'otherIncome' },
          { label: '维修修缮', key: 'reparatur' },
          { label: '中介招租', key: 'makler' },
          { label: '购置物品', key: 'anschaffung' },
          { label: '其他支出', key: 'otherExpense' }
        ];

        // 调和矿物色系
        const yearColorPalette = [
          { bg: 'rgba(56, 189, 248, 0.78)', border: '#38bdf8', text: '#7dd3fc' },   // 晨曦冰蓝
          { bg: 'rgba(52, 211, 153, 0.78)', border: '#34d399', text: '#6ee7b7' },   // 鼠尾草松绿
          { bg: 'rgba(251, 191, 36, 0.78)', border: '#fbbf24', text: '#fde047' },   // 香槟金
          { bg: 'rgba(129, 140, 248, 0.78)', border: '#818cf8', text: '#a5b4fc' },  // 鸢尾雾紫
          { bg: 'rgba(251, 113, 133, 0.78)', border: '#fb7185', text: '#fda4af' },  // 雅致珊瑚红
          { bg: 'rgba(148, 163, 184, 0.78)', border: '#cbd5e1', text: '#e2e8f0' }   // 哑光钛灰
        ];

        const datasets = years.map((yr, idx) => {
          const color = yearColorPalette[idx % yearColorPalette.length];
          const data = categories.map(cat => stats[yr][cat.key] || 0);
          return {
            label: `${yr}年`,
            data: data,
            backgroundColor: color.bg,
            borderColor: color.border,
            borderWidth: 1.5,
            borderRadius: 6,
            textColor: color.text,
            yearLabel: yr
          };
        });

        // 柱顶显式金额标注 + 柱下年份标注插件
        const barValueLabelsPlugin = {
          id: 'barValueLabels',
          afterDatasetsDraw(chart) {
            const { ctx, chartArea } = chart;
            chart.data.datasets.forEach((dataset, datasetIdx) => {
              const meta = chart.getDatasetMeta(datasetIdx);
              if (meta.hidden) return;

              meta.data.forEach((bar, index) => {
                const value = dataset.data[index];
                if (value === undefined || value === null) return;

                ctx.save();
                if (value !== 0) {
                  ctx.font = '600 10px Roboto Mono, monospace';
                  ctx.textAlign = 'center';
                  ctx.textBaseline = value >= 0 ? 'bottom' : 'top';
                  ctx.fillStyle = dataset.textColor || '#cbd5e1';

                  const formatted = (value >= 0 ? '' : '-') + Math.abs(Math.round(value)).toLocaleString('de-DE') + '€';
                  const yPos = value >= 0 ? bar.y - 4 : bar.y + 4;
                  ctx.fillText(formatted, bar.x, yPos);
                }

                ctx.font = '700 9.5px Roboto Mono, monospace';
                ctx.textAlign = 'center';
                ctx.textBaseline = 'top';
                ctx.fillStyle = dataset.textColor || '#94a3b8';

                const yearYPos = chartArea.bottom + 4;
                ctx.fillText(dataset.yearLabel || '', bar.x, yearYPos);
                ctx.restore();
              });
            });
          }
        };

        this.yearlyChartInstance = new Chart(ctx, {
          type: 'bar',
          data: {
            labels: categories.map(c => c.label),
            datasets: datasets
          },
          plugins: [barValueLabelsPlugin],
          options: {
            responsive: true,
            maintainAspectRatio: false,
            layout: {
              padding: {
                top: 24,
                bottom: 22
              }
            },
            plugins: {
              legend: {
                position: 'top',
                labels: {
                  color: '#cbd5e1',
                  font: { size: 11, family: 'Inter', weight: 500 },
                  boxWidth: 10,
                  boxHeight: 10,
                  usePointStyle: true,
                  pointStyle: 'circle',
                  padding: 16
                }
              },
              tooltip: {
                backgroundColor: 'rgba(15, 23, 42, 0.95)',
                titleColor: '#f8fafc',
                bodyColor: '#e2e8f0',
                borderColor: '#334155',
                borderWidth: 1,
                padding: 10,
                cornerRadius: 10,
                callbacks: {
                  title: (tooltipItems) => `科目: ${tooltipItems[0].label}`,
                  label: (context) => {
                    const yearLabel = context.dataset.label || '';
                    const val = context.raw || 0;
                    return ` ${yearLabel}: ${val.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} €`;
                  }
                }
              }
            },
            scales: {
              x: {
                ticks: {
                  color: '#94a3b8',
                  font: { family: 'Inter', weight: 700, size: 11 },
                  padding: 18
                },
                grid: { color: 'rgba(51, 65, 85, 0.25)' }
              },
              y: {
                ticks: {
                  color: '#94a3b8',
                  font: { family: 'Roboto Mono', size: 10.5 },
                  callback: (value) => `${value.toLocaleString('de-DE')} €`
                },
                grid: { color: 'rgba(51, 65, 85, 0.25)' }
              }
            }
          }
        });
      }

      renderYearlyInsights(years, stats) {
        const container = document.getElementById('yearlyInsightsContent');
        if (!container) return;

        let totalCf = 0;
        let totalTilgung = 0;
        let totalOtherIncome = 0;
        let totalReparatur = 0;
        let totalMakler = 0;
        let totalAnschaffung = 0;
        let totalOtherExpense = 0;

        years.forEach(yr => {
          totalCf += stats[yr].nettoCf;
          totalTilgung += stats[yr].tilgung;
          totalOtherIncome += (stats[yr].otherIncome || 0);
          totalReparatur += stats[yr].reparatur;
          totalMakler += stats[yr].makler;
          totalAnschaffung += stats[yr].anschaffung;
          totalOtherExpense += stats[yr].otherExpense;
        });

        container.innerHTML = `
          <div class="p-2.5 bg-slate-950 rounded-xl border border-slate-800 space-y-0.5">
            <span class="text-slate-400 block text-[10px]">跨年度累计落袋净现金:</span>
            <span class="text-sm font-bold font-mono ${totalCf >= 0 ? 'text-emerald-400' : 'text-rose-400'}">
              ${totalCf >= 0 ? '+' : ''}${this.formatCurrency(totalCf)}
            </span>
          </div>
          <div class="p-2.5 bg-slate-950 rounded-xl border border-slate-800 space-y-0.5">
            <span class="text-slate-400 block text-[10px]">租客帮您已还清本金总额:</span>
            <span class="text-sm font-bold font-mono text-sky-400">
              ${this.formatCurrency(totalTilgung)}
            </span>
          </div>
          <div class="p-2.5 bg-slate-950 rounded-xl border border-slate-800 grid grid-cols-2 gap-2 text-[11px] font-mono">
            <div>
              <span class="text-slate-500 block text-[10px]">累计其他收入:</span>
              <span class="text-emerald-400 font-semibold">${this.formatCurrency(totalOtherIncome)}</span>
            </div>
            <div>
              <span class="text-slate-500 block text-[10px]">累计维修支出:</span>
              <span class="text-rose-400 font-semibold">${this.formatCurrency(totalReparatur)}</span>
            </div>
            <div>
              <span class="text-slate-500 block text-[10px]">累计中介支出:</span>
              <span class="text-purple-400 font-semibold">${this.formatCurrency(totalMakler)}</span>
            </div>
            <div>
              <span class="text-slate-500 block text-[10px]">累计购置物品:</span>
              <span class="text-amber-400 font-semibold">${this.formatCurrency(totalAnschaffung)}</span>
            </div>
            <div class="col-span-2">
              <span class="text-slate-500 block text-[10px]">累计其他支出:</span>
              <span class="text-slate-300 font-semibold">${this.formatCurrency(totalOtherExpense)}</span>
            </div>
          </div>
        `;
      }

      openLedgerModal() {
        const p = this.getCurrentProperty();
        const d = new Date();
        const curM = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`;
        document.getElementById('ledgerModalTitle').innerHTML = '<i class="fa-solid fa-pen-to-square text-sky-400"></i><span>录入单月收支记录</span>';
        document.getElementById('ledgerModalMonth').value = curM;
        this.onLedgerModalMonthChange(curM);
        document.getElementById('ledgerModal').classList.remove('hidden');
      }

      editLedgerEntry(monthKey) {
        document.getElementById('ledgerModalTitle').innerHTML = `<i class="fa-solid fa-pen-to-square text-sky-400"></i><span>修改 ${monthKey} 月度记录</span>`;
        document.getElementById('ledgerModalMonth').value = monthKey;
        this.onLedgerModalMonthChange(monthKey);
        document.getElementById('ledgerModal').classList.remove('hidden');
      }

      closeLedgerModal() {
        document.getElementById('ledgerModal').classList.add('hidden');
      }

      onLedgerModalMonthChange(mKey) {
        const p = this.getCurrentProperty();
        const existing = p.ledger.find(item => item.month === mKey);

        if (existing) {
          document.getElementById('modalInputKalt').value = existing.kalt;
          document.getElementById('modalInputNk').value = existing.nk;
          document.getElementById('modalInputOtherIncome').value = existing.otherIncome || 0;
          document.getElementById('modalInputZins').value = existing.zins;
          document.getElementById('modalInputTilgung').value = existing.tilgung;
          document.getElementById('modalInputHausgeld').value = existing.hausgeld;
          document.getElementById('modalInputReparatur').value = existing.reparatur || 0;
          document.getElementById('modalInputMakler').value = existing.makler || 0;
          document.getElementById('modalInputAnschaffung').value = existing.anschaffung || 0;
          document.getElementById('modalInputOtherExpense').value = existing.otherExpense !== undefined ? existing.otherExpense : (existing.other || 0);
          document.getElementById('modalInputNote').value = existing.note || '';
        } else {
          const calculated = this.calculateMonthlyLoanComponentsForDate(p, mKey);
          document.getElementById('modalInputKalt').value = p.kaltmiete;
          document.getElementById('modalInputNk').value = p.nebenkostenVorausz;
          document.getElementById('modalInputOtherIncome').value = 0;
          document.getElementById('modalInputZins').value = calculated.zins;
          document.getElementById('modalInputTilgung').value = calculated.tilgung;
          document.getElementById('modalInputHausgeld').value = p.hausgeld;
          document.getElementById('modalInputReparatur').value = 0;
          document.getElementById('modalInputMakler').value = 0;
          document.getElementById('modalInputAnschaffung').value = 0;
          document.getElementById('modalInputOtherExpense').value = 0;
          document.getElementById('modalInputNote').value = '智能推算月结';
        }
      }

      calculateMonthlyLoanComponentsForDate(p, mKey) {
        const startParts = (p.uebergang || '2024-11-01').split('-').map(Number);
        const curParts = mKey.split('-').map(Number);
        const monthsPassed = Math.max(0, (curParts[0] - startParts[0]) * 12 + (curParts[1] - startParts[1]));

        let combinedZins = 0;
        let combinedTilgung = 0;

        const activeLoans = [];
        if (p.loans.loan1) activeLoans.push(p.loans.loan1);
        if (p.loans.loan2 && p.loans.loan2.active) activeLoans.push(p.loans.loan2);
        if (p.loans.loan3 && p.loans.loan3.active) activeLoans.push(p.loans.loan3);

        activeLoans.forEach(ln => {
          let bal = ln.amount;
          const zinsRate = ln.rate / 100;
          const annuitaet = ln.amount * ((ln.rate + ln.tilgung) / 100) / 12;

          let curZins = (bal * zinsRate) / 12;
          let curTilg = annuitaet - curZins;

          for (let i = 0; i < monthsPassed; i++) {
            curZins = (bal * zinsRate) / 12;
            curTilg = annuitaet - curZins;
            bal = Math.max(0, bal - curTilg);
          }

          combinedZins += curZins;
          combinedTilgung += curTilg;
        });

        return {
          zins: Math.round(combinedZins * 100) / 100,
          tilgung: Math.round(combinedTilgung * 100) / 100
        };
      }

      saveLedgerModalEntry() {
        const p = this.getCurrentProperty();
        const mKey = document.getElementById('ledgerModalMonth').value;
        if (!mKey) return;

        const newEntry = {
          month: mKey,
          kalt: parseFloat(document.getElementById('modalInputKalt').value) || 0,
          nk: parseFloat(document.getElementById('modalInputNk').value) || 0,
          otherIncome: parseFloat(document.getElementById('modalInputOtherIncome').value) || 0,
          zins: parseFloat(document.getElementById('modalInputZins').value) || 0,
          tilgung: parseFloat(document.getElementById('modalInputTilgung').value) || 0,
          hausgeld: parseFloat(document.getElementById('modalInputHausgeld').value) || 0,
          reparatur: parseFloat(document.getElementById('modalInputReparatur').value) || 0,
          makler: parseFloat(document.getElementById('modalInputMakler').value) || 0,
          anschaffung: parseFloat(document.getElementById('modalInputAnschaffung').value) || 0,
          otherExpense: parseFloat(document.getElementById('modalInputOtherExpense').value) || 0,
          note: document.getElementById('modalInputNote').value || ''
        };

        const existingIdx = p.ledger.findIndex(item => item.month === mKey);

        if (existingIdx !== -1) {
          const old = p.ledger[existingIdx];
          const oldExp = old.otherExpense !== undefined ? old.otherExpense : (old.other || 0);
          const isConflict = (
            (old.kalt > 0 && Math.abs(old.kalt - newEntry.kalt) > 0.01) ||
            (old.nk > 0 && Math.abs(old.nk - newEntry.nk) > 0.01) ||
            ((old.otherIncome || 0) > 0 && Math.abs((old.otherIncome || 0) - newEntry.otherIncome) > 0.01) ||
            (old.zins > 0 && Math.abs(old.zins - newEntry.zins) > 0.5) ||
            (old.tilgung > 0 && Math.abs(old.tilgung - newEntry.tilgung) > 0.5) ||
            (old.hausgeld > 0 && Math.abs(old.hausgeld - newEntry.hausgeld) > 0.01) ||
            (old.reparatur > 0 && Math.abs(old.reparatur - newEntry.reparatur) > 0.01) ||
            (old.makler > 0 && Math.abs(old.makler - newEntry.makler) > 0.01) ||
            (old.anschaffung > 0 && Math.abs(old.anschaffung - newEntry.anschaffung) > 0.01) ||
            (oldExp > 0 && Math.abs(oldExp - newEntry.otherExpense) > 0.01)
          );

          if (isConflict) {
            this.showDiffModal(old, newEntry, () => {
              p.ledger[existingIdx] = newEntry;
              this.closeLedgerModal();
              this.renderLedger();
              this.renderPortfolio();
              this.showToast(`已更新 ${mKey} 月度记录`);
            });
            return;
          }

          p.ledger[existingIdx] = newEntry;
          this.closeLedgerModal();
          this.renderLedger();
          this.renderPortfolio();
          this.showToast(`已成功为 ${mKey} 补充录入记录`);
          return;
        }

        p.ledger.push(newEntry);
        this.closeLedgerModal();
        this.renderLedger();
        this.renderPortfolio();
        this.showToast(`已成功录入 ${mKey} 月份记录`);
      }

      showDiffModal(oldData, newData, onConfirm) {
        const modal = document.getElementById('diffConfirmModal');
        const content = document.getElementById('diffConfirmContent');
        const confirmBtn = document.getElementById('diffConfirmBtn');
        document.getElementById('diffModalTitle').innerText = '数据覆盖确认 / Überschreiben bestätigen';

        const oldExp = oldData.otherExpense !== undefined ? oldData.otherExpense : (oldData.other || 0);

        const fields = [
          { label: '冷租收入', oldV: oldData.kalt, newV: newData.kalt },
          { label: '预缴杂费', oldV: oldData.nk, newV: newData.nk },
          { label: '其他收入', oldV: oldData.otherIncome || 0, newV: newData.otherIncome || 0 },
          { label: '银行利息', oldV: oldData.zins, newV: newData.zins },
          { label: '银行还本', oldV: oldData.tilgung, newV: newData.tilgung },
          { label: '物业费', oldV: oldData.hausgeld, newV: newData.hausgeld },
          { label: '维修支出', oldV: oldData.reparatur, newV: newData.reparatur },
          { label: '中介支出', oldV: oldData.makler, newV: newData.makler },
          { label: '购置物品', oldV: oldData.anschaffung, newV: newData.anschaffung },
          { label: '其他支出', oldV: oldExp, newV: newData.otherExpense }
        ];

        const changed = fields.filter(f => Math.abs((f.oldV || 0) - (f.newV || 0)) > 0.01);

        content.innerHTML = `
          <p class="text-slate-300">检测到 <span class="text-amber-400 font-bold">${oldData.month}</span> 已有数据将被修改：</p>
          <div class="p-3 bg-slate-950 rounded-xl border border-slate-800 space-y-1.5 font-mono text-[11px]">
            ${changed.map(c => `
              <div class="flex justify-between items-center py-0.5 border-b border-slate-900">
                <span class="text-slate-400">${c.label}:</span>
                <div class="flex items-center gap-2">
                  <span class="line-through text-slate-500">${this.formatCurrency(c.oldV)}</span>
                  <span class="text-amber-400 font-bold">→ ${this.formatCurrency(c.newV)}</span>
                </div>
              </div>
            `).join('')}
          </div>
          <p class="text-[11px] text-slate-400">是否确认用新数据覆盖原记录？</p>
        `;

        confirmBtn.onclick = () => {
          modal.classList.add('hidden');
          onConfirm();
        };

        modal.classList.remove('hidden');
      }

      deleteLedgerEntry(mKey) {
        const p = this.getCurrentProperty();
        const idx = p.ledger.findIndex(item => item.month === mKey);
        if (idx !== -1) {
          p.ledger.splice(idx, 1);
          this.renderLedger();
          this.renderPortfolio();
          this.showToast(`已删除 ${mKey} 月度记录`);
        }
      }

      openBatchGenerateModal() {
        const p = this.getCurrentProperty();
        // 自动带入当前房产配置的基准冷租、预缴杂费与物业费
        const kaltEl = document.getElementById('batchInputKalt');
        const nkEl = document.getElementById('batchInputNk');
        const hgEl = document.getElementById('batchInputHausgeld');
        if (kaltEl) kaltEl.value = p.kaltmiete;
        if (nkEl) nkEl.value = p.nebenkostenVorausz;
        if (hgEl) hgEl.value = p.hausgeld;

        document.getElementById('batchGenerateModal').classList.remove('hidden');
      }

      closeBatchGenerateModal() {
        document.getElementById('batchGenerateModal').classList.add('hidden');
      }

      runBatchGenerate() {
        const p = this.getCurrentProperty();
        const startStr = document.getElementById('batchStartMonth').value;
        const endStr = document.getElementById('batchEndMonth').value;
        const overwrite = document.getElementById('batchOverwrite').checked;

        if (!startStr || !endStr) return;

        // 优先读取弹窗中输入的参数，若未填则使用默认
        const kalt = parseFloat(document.getElementById('batchInputKalt')?.value) || p.kaltmiete;
        const nk = parseFloat(document.getElementById('batchInputNk')?.value) || p.nebenkostenVorausz;
        const hausgeld = parseFloat(document.getElementById('batchInputHausgeld')?.value) || p.hausgeld;

        const startParts = startStr.split('-').map(Number);
        const endParts = endStr.split('-').map(Number);
        let cur = new Date(startParts[0], startParts[1] - 1, 1);
        const end = new Date(endParts[0], endParts[1] - 1, 1);

        let count = 0;
        while (cur <= end) {
          const y = cur.getFullYear();
          const m = String(cur.getMonth() + 1).padStart(2, '0');
          const mKey = `${y}-${m}`;

          const existingIdx = p.ledger.findIndex(item => item.month === mKey);

          if (existingIdx === -1 || overwrite) {
            const calculated = this.calculateMonthlyLoanComponentsForDate(p, mKey);
            const entry = {
              month: mKey,
              kalt,
              nk,
              otherIncome: 0,
              zins: calculated.zins,
              tilgung: calculated.tilgung,
              hausgeld,
              reparatur: 0,
              makler: 0,
              anschaffung: 0,
              otherExpense: 0,
              note: '区间批量排布'
            };

            if (existingIdx !== -1 && overwrite) {
              p.ledger[existingIdx] = entry;
            } else {
              p.ledger.push(entry);
            }
            count++;
          }
          cur.setMonth(cur.getMonth() + 1);
        }

        this.closeBatchGenerateModal();
        this.renderLedger();
        this.renderPortfolio();
        this.showToast(`已成功排布 ${count} 个月份流水`);
      }

      // ================= 智能检测与空缺补录 =================
      checkCatchUpNeeded() {
        const p = this.getCurrentProperty();
        const d = new Date();
        const curM = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`;
        const startM = p.uebergang ? p.uebergang.substring(0, 7) : '2024-11';

        const missing = [];
        const startParts = startM.split('-').map(Number);
        const endParts = curM.split('-').map(Number);
        let t = new Date(startParts[0], startParts[1] - 1, 1);
        const end = new Date(endParts[0], endParts[1] - 1, 1);

        while (t <= end) {
          const mKey = `${t.getFullYear()}-${String(t.getMonth() + 1).padStart(2, '0')}`;
          if (!p.ledger.some(item => item.month === mKey)) {
            missing.push(mKey);
          }
          t.setMonth(t.getMonth() + 1);
        }

        const banner = document.getElementById('catchUpBanner');
        if (banner) {
          if (missing.length > 0) {
            document.getElementById('catchUpBannerText').innerHTML = `
              检测到从 <b class="text-amber-300 font-mono">${missing[0]}</b> 至 <b class="text-amber-300 font-mono">${missing[missing.length - 1]}</b> 共有 <b class="text-white">${missing.length}</b> 个月份尚未记录。
            `;
            banner.classList.remove('hidden');
          } else {
            banner.classList.add('hidden');
          }
        }
      }

      dismissCatchUpBanner() {
        document.getElementById('catchUpBanner').classList.add('hidden');
      }

      runCatchUpFromBanner() {
        const p = this.getCurrentProperty();
        const d = new Date();
        const curM = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`;
        const startM = p.uebergang ? p.uebergang.substring(0, 7) : '2024-11';

        const added = [];
        const startParts = startM.split('-').map(Number);
        const endParts = curM.split('-').map(Number);
        let t = new Date(startParts[0], startParts[1] - 1, 1);
        const end = new Date(endParts[0], endParts[1] - 1, 1);

        while (t <= end) {
          const mKey = `${t.getFullYear()}-${String(t.getMonth() + 1).padStart(2, '0')}`;
          if (!p.ledger.some(item => item.month === mKey)) {
            const calculated = this.calculateMonthlyLoanComponentsForDate(p, mKey);
            p.ledger.push({
              month: mKey,
              kalt: p.kaltmiete,
              nk: p.nebenkostenVorausz,
              zins: calculated.zins,
              tilgung: calculated.tilgung,
              hausgeld: p.hausgeld,
              reparatur: 0,
              makler: 0,
              anschaffung: 0,
              other: 0,
              note: '自动智能结转'
            });
            added.push(mKey);
          }
          t.setMonth(t.getMonth() + 1);
        }

        this.dismissCatchUpBanner();
        this.renderLedger();
        this.renderPortfolio();

        const recapModal = document.getElementById('catchUpRecapModal');
        const recapContent = document.getElementById('catchUpRecapContent');
        recapContent.innerHTML = `
          <p>已成功为您自动补齐以下 <b class="text-emerald-400 font-bold">${added.length}</b> 个月份基准账单：</p>
          <div class="p-3 bg-slate-950 rounded-xl border border-slate-800 max-h-48 overflow-y-auto space-y-1 font-mono text-[11px]">
            ${added.map(m => `<div class="flex justify-between py-0.5 border-b border-slate-900"><span>${m}</span><span class="text-sky-400">+${p.kaltmiete} € 冷租 / -${p.hausgeld} € 物业</span></div>`).join('')}
          </div>
          <p class="text-[11px] text-slate-400">所有月份维修等支出已默认为 0 €。如若个别月份有额外花销，可在【按月收支账本】中点击对应月份的【修改】随时调整。</p>
        `;
        recapModal.classList.remove('hidden');
      }

      closeCatchUpRecapModal() {
        document.getElementById('catchUpRecapModal').classList.add('hidden');
      }

      // ================= 板块 4: 物业决算录入与对账 (WEG) =================
      renderWegSettlement() {
        const p = this.getCurrentProperty();
        const tbody = document.getElementById('wegTableBody');
        if (!tbody) return;

        if (!p.wegSettlements || p.wegSettlements.length === 0) {
          tbody.innerHTML = `<tr><td colspan="10" class="p-6 text-center text-slate-500 font-sans">暂无录入的物业年度决算单记录。</td></tr>`;
          return;
        }

        tbody.innerHTML = p.wegSettlements.map((w, idx) => `
          <tr class="hover:bg-slate-800/40">
            <td class="p-3 font-bold text-white whitespace-nowrap">${w.year} 年度</td>
            <td class="p-3 text-slate-400 whitespace-nowrap">${w.valutaDate}</td>
            <td class="p-3 text-right whitespace-nowrap">${this.formatCurrency(w.umlage)}</td>
            <td class="p-3 text-right whitespace-nowrap">${this.formatCurrency(w.nichtUmlage)}</td>
            <td class="p-3 text-right text-amber-200 font-bold whitespace-nowrap">${this.formatCurrency(w.ruecklageZufuehrung || 0)}</td>
            <td class="p-3 text-right text-amber-400 font-bold whitespace-nowrap">${this.formatCurrency(w.ruecklageEntnahme || 0)}</td>
            <td class="p-3 text-right font-bold whitespace-nowrap ${w.totalDiff >= 0 ? 'text-rose-400' : 'text-emerald-400'}">${w.totalDiff >= 0 ? '+' : ''}${this.formatCurrency(w.totalDiff)}</td>
            <td class="p-3 text-right font-bold whitespace-nowrap ${w.mieterDiff >= 0 ? 'text-emerald-400' : 'text-rose-400'}">${w.mieterDiff >= 0 ? '+' : ''}${this.formatCurrency(w.mieterDiff)}</td>
            <td class="p-3 text-sky-400 whitespace-nowrap">${w.mieterMonth || '-'}</td>
            <td class="p-3 text-center whitespace-nowrap">
              <div class="flex items-center justify-center gap-1.5">
                <button onclick="app.editWegEntry(${idx})" title="修改决算单" class="p-1 px-2 rounded bg-slate-800 hover:bg-sky-900 text-sky-400 text-xs transition">
                  <i class="fa-solid fa-pen"></i>
                </button>
                <button onclick="app.deleteWegEntry(${idx})" title="删除决算单" class="p-1 px-2 rounded bg-slate-800 hover:bg-rose-950 text-rose-400 text-xs transition">
                  <i class="fa-solid fa-trash-can"></i>
                </button>
              </div>
            </td>
          </tr>
        `).join('');
      }

      openWegModal() {
        this.editingWegIndex = null;
        document.getElementById('wegModalTitle').innerHTML = '<i class="fa-solid fa-file-invoice-dollar text-sky-400"></i><span>录入物业年度决算 (WEG-Abrechnung)</span>';
        document.getElementById('wegInputYear').value = 2024;
        document.getElementById('wegInputValutaDate').value = '2025-10-15';
        document.getElementById('wegInputUmlage').value = 2680;
        document.getElementById('wegInputNichtUmlage').value = 450;
        document.getElementById('wegInputRuecklageZufuehrung').value = 420;
        document.getElementById('wegInputRuecklageEntnahme').value = 0;
        document.getElementById('wegInputTotalDiffType').value = 'pay';
        document.getElementById('wegInputTotalDiff').value = 120;
        document.getElementById('wegInputMieterMonth').value = '2025-11';
        this.updateWegDiffTypeVisual();
        this.calcWegSummary();
        document.getElementById('wegModal').classList.remove('hidden');
      }

      editWegEntry(idx) {
        const p = this.getCurrentProperty();
        if (!p.wegSettlements || !p.wegSettlements[idx]) return;
        const w = p.wegSettlements[idx];
        this.editingWegIndex = idx;

        document.getElementById('wegModalTitle').innerHTML = `<i class="fa-solid fa-pen-to-square text-sky-400"></i><span>修改 ${w.year} 年度决算单</span>`;
        document.getElementById('wegInputYear').value = w.year;
        document.getElementById('wegInputValutaDate').value = w.valutaDate;
        document.getElementById('wegInputUmlage').value = w.umlage;
        document.getElementById('wegInputNichtUmlage').value = w.nichtUmlage;
        document.getElementById('wegInputRuecklageZufuehrung').value = w.ruecklageZufuehrung !== undefined ? w.ruecklageZufuehrung : 420;
        document.getElementById('wegInputRuecklageEntnahme').value = w.ruecklageEntnahme || 0;
        
        const rawDiff = w.totalDiff || 0;
        if (rawDiff < 0) {
          document.getElementById('wegInputTotalDiffType').value = 'refund';
          document.getElementById('wegInputTotalDiff').value = Math.abs(rawDiff);
        } else {
          document.getElementById('wegInputTotalDiffType').value = 'pay';
          document.getElementById('wegInputTotalDiff').value = rawDiff;
        }

        document.getElementById('wegInputMieterMonth').value = w.mieterMonth || '';
        this.updateWegDiffTypeVisual();
        this.calcWegSummary();
        document.getElementById('wegModal').classList.remove('hidden');
      }

      updateWegDiffTypeVisual() {
        const typeSelect = document.getElementById('wegInputTotalDiffType');
        const diffInput = document.getElementById('wegInputTotalDiff');
        const badge = document.getElementById('wegDiffBadge');
        if (!typeSelect || !diffInput || !badge) return;

        const isPay = typeSelect.value === 'pay';
        const amount = Math.abs(parseFloat(diffInput.value) || 0);

        if (isPay) {
          typeSelect.className = 'w-full bg-slate-900 border border-rose-500/60 rounded-lg px-3 py-2 text-xs font-bold text-rose-400 outline-none cursor-pointer';
          badge.className = 'text-xs font-bold text-rose-400 font-mono';
          badge.innerText = `房东向物业补缴款: ${this.formatCurrency(amount)}`;
        } else {
          typeSelect.className = 'w-full bg-slate-900 border border-emerald-500/60 rounded-lg px-3 py-2 text-xs font-bold text-emerald-400 outline-none cursor-pointer';
          badge.className = 'text-xs font-bold text-emerald-400 font-mono';
          badge.innerText = `物业向房东退还款: ${this.formatCurrency(amount)}`;
        }
      }

      closeWegModal() {
        this.editingWegIndex = null;
        document.getElementById('wegModal').classList.add('hidden');
      }

      onWegYearChange() {
        this.calcWegSummary();
      }

      calcWegSummary() {
        const p = this.getCurrentProperty();
        const yr = document.getElementById('wegInputYear').value;
        const umlage = parseFloat(document.getElementById('wegInputUmlage').value) || 0;

        let tenantPrepaid = 0;
        p.ledger.forEach(item => {
          if (item.month.startsWith(yr)) {
            tenantPrepaid += (item.nk || 0);
          }
        });

        if (tenantPrepaid === 0) tenantPrepaid = p.nebenkostenVorausz * 12;

        const diff = umlage - tenantPrepaid;
        document.getElementById('wegMieterPrepaid').innerText = this.formatCurrency(tenantPrepaid);
        document.getElementById('wegMieterResult').innerHTML = diff >= 0
          ? `<span class="text-emerald-400">+${this.formatCurrency(diff)} (租客需补缴 Nachzahlung)</span>`
          : `<span class="text-rose-400">${this.formatCurrency(diff)} (应退还租客 Guthaben)</span>`;
      }

      saveWegModalEntry() {
        const p = this.getCurrentProperty();
        const year = document.getElementById('wegInputYear').value;
        const valutaDate = document.getElementById('wegInputValutaDate').value;
        const umlage = parseFloat(document.getElementById('wegInputUmlage').value) || 0;
        const nichtUmlage = parseFloat(document.getElementById('wegInputNichtUmlage').value) || 0;
        const ruecklageZufuehrung = parseFloat(document.getElementById('wegInputRuecklageZufuehrung').value) || 0;
        const ruecklageEntnahme = parseFloat(document.getElementById('wegInputRuecklageEntnahme').value) || 0;
        
        // 读取明确的类型与金额，正数为补缴，负数为退款
        const diffType = document.getElementById('wegInputTotalDiffType').value;
        const absDiffVal = Math.abs(parseFloat(document.getElementById('wegInputTotalDiff').value) || 0);
        const totalDiff = diffType === 'refund' ? -absDiffVal : absDiffVal;

        const mieterMonth = document.getElementById('wegInputMieterMonth').value;
        const autoPost = document.getElementById('wegAutoPost').checked;

        let tenantPrepaid = 0;
        p.ledger.forEach(item => {
          if (item.month.startsWith(year)) tenantPrepaid += (item.nk || 0);
        });
        if (tenantPrepaid === 0) tenantPrepaid = p.nebenkostenVorausz * 12;
        const mieterDiff = umlage - tenantPrepaid;

        if (!p.wegSettlements) p.wegSettlements = [];
        const record = {
          year, valutaDate, umlage, nichtUmlage, ruecklageZufuehrung, ruecklageEntnahme, totalDiff, mieterDiff, mieterMonth
        };

        if (this.editingWegIndex !== null && this.editingWegIndex >= 0) {
          p.wegSettlements[this.editingWegIndex] = record;
        } else {
          p.wegSettlements.push(record);
        }

        // 智能安全记账：正向补缴进入【其他收入】，物业补缴/退租客进入【其他支出】
        if (autoPost) {
          // 1. 物业结算差额
          if (Math.abs(totalDiff) > 0.01 && valutaDate) {
            const wegMonth = valutaDate.substring(0, 7);
            let wegMEntry = p.ledger.find(item => item.month === wegMonth);
            if (!wegMEntry) {
              const calc = this.calculateMonthlyLoanComponentsForDate(p, wegMonth);
              wegMEntry = {
                month: wegMonth,
                kalt: p.kaltmiete,
                nk: p.nebenkostenVorausz,
                otherIncome: 0,
                zins: calc.zins,
                tilgung: calc.tilgung,
                hausgeld: p.hausgeld,
                reparatur: 0,
                makler: 0,
                anschaffung: 0,
                otherExpense: 0,
                note: ''
              };
              p.ledger.push(wegMEntry);
            }
            if (totalDiff > 0) {
              // 房东补交物业 -> 计入其他支出
              wegMEntry.otherExpense = Math.round(((wegMEntry.otherExpense || 0) + totalDiff) * 100) / 100;
            } else {
              // 物业退款房东 -> 计入其他收入
              wegMEntry.otherIncome = Math.round(((wegMEntry.otherIncome || 0) + Math.abs(totalDiff)) * 100) / 100;
            }
            const noteText = `${year}年物业决算差额: ${totalDiff >= 0 ? '+' : ''}${totalDiff}€`;
            if (!wegMEntry.note || !wegMEntry.note.includes(noteText)) {
              wegMEntry.note = (wegMEntry.note ? wegMEntry.note + ' | ' : '') + noteText;
            }
          }

          // 2. 租客补缴与退款
          if (Math.abs(mieterDiff) > 0.01 && mieterMonth) {
            let mieterMEntry = p.ledger.find(item => item.month === mieterMonth);
            if (!mieterMEntry) {
              const calc = this.calculateMonthlyLoanComponentsForDate(p, mieterMonth);
              mieterMEntry = {
                month: mieterMonth,
                kalt: p.kaltmiete,
                nk: p.nebenkostenVorausz,
                otherIncome: 0,
                zins: calc.zins,
                tilgung: calc.tilgung,
                hausgeld: p.hausgeld,
                reparatur: 0,
                makler: 0,
                anschaffung: 0,
                otherExpense: 0,
                note: ''
              };
              p.ledger.push(mieterMEntry);
            }
            if (mieterDiff > 0) {
              // 租客补缴 -> 计入其他收入 (Sonstige Einnahmen)
              mieterMEntry.otherIncome = Math.round(((mieterMEntry.otherIncome || 0) + mieterDiff) * 100) / 100;
            } else {
              // 房东退还租客 -> 计入其他支出 (Sonstige Ausgaben)
              mieterMEntry.otherExpense = Math.round(((mieterMEntry.otherExpense || 0) + Math.abs(mieterDiff)) * 100) / 100;
            }
            const mieterNoteText = `${year}年租客决算${mieterDiff >= 0 ? '补缴' : '退款'}: ${mieterDiff >= 0 ? '+' : ''}${mieterDiff}€`;
            if (!mieterMEntry.note || !mieterMEntry.note.includes(mieterNoteText)) {
              mieterMEntry.note = (mieterMEntry.note ? mieterMEntry.note + ' | ' : '') + mieterNoteText;
            }
          }
        }

        const isEdit = this.editingWegIndex !== null;
        this.closeWegModal();
        this.renderWegSettlement();
        this.renderLedger();
        this.renderPortfolio();
        this.showToast(isEdit ? '物业决算单修改成功，数据已更新！' : '物业年度决算录入成功，已同步！');
      }

      deleteWegEntry(idx) {
        const p = this.getCurrentProperty();
        if (p.wegSettlements) {
          p.wegSettlements.splice(idx, 1);
          this.renderWegSettlement();
          this.showToast('已删除决算记录');
        }
      }

      // ================= 板块 5: Anlage V 报税清单 (Steuern) =================
      renderTaxView() {
        const p = this.getCurrentProperty();
        const selYear = document.getElementById('taxYearSelect').value;
        const marginalRate = parseFloat(document.getElementById('inputTaxMarginalRate').value) || 42;

        let kaltTotal = 0, nkTotal = 0, otherIncomeTotal = 0;
        let zinsTotal = 0, reparaturTotal = 0, hausgeldTotal = 0, sonstigeExpenseTotal = 0;

        p.ledger.forEach(item => {
          if (item.month.startsWith(selYear)) {
            const otherExp = item.otherExpense !== undefined ? item.otherExpense : (item.other > 0 ? item.other : 0);
            kaltTotal += (item.kalt || 0);
            nkTotal += (item.nk || 0);
            otherIncomeTotal += (item.otherIncome || 0);
            zinsTotal += (item.zins || 0);
            reparaturTotal += (item.reparatur || 0);
            hausgeldTotal += (item.hausgeld || 0);
            sonstigeExpenseTotal += ((item.makler || 0) + (item.anschaffung || 0) + otherExp);
          }
        });

        let ruecklageDeduction = 0;
        if (p.wegSettlements) {
          p.wegSettlements.forEach(w => {
            if (w.year === selYear) ruecklageDeduction += (w.ruecklageEntnahme || 0);
          });
        }
        reparaturTotal += ruecklageDeduction;

        const gebaeudeVal = p.kaufpreis * (p.gebaeudeAnteil / 100);
        const afaVal = gebaeudeVal * (p.afaRate / 100);

        const totalEinnahmen = kaltTotal + nkTotal + otherIncomeTotal;
        const totalWerbungskosten = afaVal + zinsTotal + reparaturTotal + hausgeldTotal + sonstigeExpenseTotal;
        const taxResult = totalEinnahmen - totalWerbungskosten;
        const taxImpact = taxResult * (marginalRate / 100);

        document.getElementById('taxSumKaltmiete').innerText = this.formatCurrency(kaltTotal);
        document.getElementById('taxSumNebenkosten').innerText = this.formatCurrency(nkTotal + otherIncomeTotal);
        document.getElementById('taxTotalEinnahmen').innerText = this.formatCurrency(totalEinnahmen);

        document.getElementById('taxAfaVal').innerText = this.formatCurrency(afaVal);
        document.getElementById('taxSumZinsen').innerText = this.formatCurrency(zinsTotal);
        document.getElementById('taxSumReparatur').innerText = this.formatCurrency(reparaturTotal);
        document.getElementById('taxSumHausgeld').innerText = this.formatCurrency(hausgeldTotal);
        document.getElementById('taxSumSonstige').innerText = this.formatCurrency(sonstigeExpenseTotal);
        document.getElementById('taxTotalWerbungskosten').innerText = this.formatCurrency(totalWerbungskosten);

        const resEl = document.getElementById('taxFinalResult');
        resEl.innerText = `${taxResult >= 0 ? '+' : ''}${this.formatCurrency(taxResult)}`;
        resEl.className = `text-2xl font-black mt-1 ${taxResult >= 0 ? 'text-amber-400' : 'text-emerald-400'}`;

        const impactEl = document.getElementById('taxImpactVal');
        impactEl.innerText = `${taxImpact >= 0 ? '需补税: ' : '可退税: '}${this.formatCurrency(Math.abs(taxImpact))}`;
        impactEl.className = `text-base font-bold ${taxImpact >= 0 ? 'text-rose-400' : 'text-emerald-400'}`;

        const limit15Max = gebaeudeVal * 0.15;
        let threeYearReparatur = 0;
        p.ledger.forEach(item => {
          threeYearReparatur += (item.reparatur || 0);
        });
        const limit15Ratio = limit15Max > 0 ? Math.min(100, (threeYearReparatur / limit15Max) * 100) : 0;
        document.getElementById('tax15Used').innerText = this.formatCurrency(threeYearReparatur);
        document.getElementById('tax15Max').innerText = this.formatCurrency(limit15Max);
        document.getElementById('tax15LimitRatio').innerText = `${limit15Ratio.toFixed(1)}% / 15.0%`;
        document.getElementById('tax15LimitBar').style.width = `${limit15Ratio}%`;
      }

      showAddPropertyModal() {
        document.getElementById('addPropertyModal').classList.remove('hidden');
      }

      closeAddPropertyModal() {
        document.getElementById('addPropertyModal').classList.add('hidden');
      }

      confirmAddProperty() {
        const name = document.getElementById('newPropName').value || '新建房产';
        const kaufpreis = parseFloat(document.getElementById('newPropKaufpreis').value) || 200000;
        const kaltmiete = parseFloat(document.getElementById('newPropKaltmiete').value) || 800;

        const newId = `prop-${Date.now()}`;
        const newProp = {
          id: newId,
          name: name,
          kaufpreis: kaufpreis,
          gebaeudeAnteil: 80,
          afaRate: 2.0,
          kaufNkPercent: 8.5,
          uebergang: '2025-01-01',
          kaltmiete: kaltmiete,
          nebenkostenVorausz: 200,
          hausgeld: 280,
          ruecklageAnteil: 40,
          umlageAnteil: 190,
          loans: {
            loan1: {
              amount: Math.round(kaufpreis * 0.7),
              rate: 3.75,
              tilgung: 2.0
            },
            loan2: { active: true, amount: 50000, rate: 1.25, tilgung: 2.5 },
            loan3: { active: false, amount: 0, rate: 0, tilgung: 0 }
          },
          wegSettlements: [],
          ledger: []
        };

        this.portfolio.push(newProp);
        this.closeAddPropertyModal();
        this.switchProperty(newId);
        this.showToast(`成功添加新房产: ${name}`);
      }
    }

    // 全局启动入口
    window.onload = function() {
      window.app = new RealEstateSystem();
      window.app.init();
    };
  </script>
</body>
</html>

